param(
    [ValidateSet('Prepare','Configure','Remove')][string]$Mode = 'Configure',
    [Parameter(Mandatory=$true)][string]$AppDirectory,
    [string]$StateDirectory,
    [string]$StorageRoot,
    [int]$Port = 3123,
    [string]$BindAddress = '127.0.0.1',
    [switch]$RequireApiKey,
    [switch]$InstallService
)
$ErrorActionPreference = 'Stop'
$env:PSModulePath = [IO.Path]::Combine($PSHOME, 'Modules')
$AppDirectory = [IO.Path]::GetFullPath($AppDirectory).TrimEnd('\')
$Wrapper = Join-Path $AppDirectory 'TerrainServerService.exe'
$Principal = [Security.Principal.WindowsPrincipal]::new([Security.Principal.WindowsIdentity]::GetCurrent())
$Elevated = $Principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

function Get-OwnedService {
    $Service = Get-CimInstance Win32_Service -Filter "Name='TerrainServer'" -ErrorAction Stop
    if ($Service) {
        $Match = [regex]::Match($Service.PathName, '^(?:"([^"]+)"|(\S+))')
        $Binary = if ($Match.Groups[1].Success) { $Match.Groups[1].Value } else { $Match.Groups[2].Value }
        if (-not [string]::Equals([IO.Path]::GetFullPath($Binary), $Wrapper, [StringComparison]::OrdinalIgnoreCase)) {
            throw 'A TerrainServer service belongs to another installation. Upgrade that installation in place or remove its service explicitly.'
        }
    }
    return $Service
}

function Stop-OwnedService {
    $Service = Get-OwnedService
    if ($Service -and $Service.State -ne 'Stopped') {
        Stop-Service -Name TerrainServer -ErrorAction Stop
        (Get-Service TerrainServer).WaitForStatus('Stopped', [TimeSpan]::FromSeconds(60))
    }
    return $Service
}

function Protect-State([string]$Directory) {
    $Directory = [IO.Path]::GetFullPath($Directory).TrimEnd('\')
    if ($Directory -eq [IO.Path]::GetPathRoot($Directory).TrimEnd('\') -or $Directory -eq $AppDirectory -or $Directory.StartsWith($AppDirectory+'\', [StringComparison]::OrdinalIgnoreCase)) {
        throw 'Choose a dedicated state directory outside the program directory, not a volume root.'
    }
    [IO.Directory]::CreateDirectory($Directory) | Out-Null
    $Acl = [Security.AccessControl.DirectorySecurity]::new()
    $Acl.SetAccessRuleProtection($true, $false)
    foreach ($Sid in @('S-1-5-18','S-1-5-32-544')) {
        $Rule = [Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($Sid),'FullControl','ContainerInherit,ObjectInherit','None','Allow')
        $Acl.AddAccessRule($Rule)
    }
    $User = [Security.Principal.WindowsIdentity]::GetCurrent().User
    $Acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new($User,'FullControl','ContainerInherit,ObjectInherit','None','Allow'))
    if ($InstallService) {
        $Acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new('S-1-5-19'),'Modify','ContainerInherit,ObjectInherit','None','Allow'))
    }
    [IO.Directory]::SetAccessControl($Directory, $Acl)
}

function Grant-ServiceStorage([string]$Directory) {
    $Acl = [Security.AccessControl.DirectorySecurity]::new($Directory, [Security.AccessControl.AccessControlSections]::Access)
    $Acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new('S-1-5-19'),'Modify','ContainerInherit,ObjectInherit','None','Allow'))
    [IO.Directory]::SetAccessControl($Directory, $Acl)
}

try {
    if ($Mode -eq 'Prepare') {
        if (-not $Elevated) { throw 'Service installation requires an administrator.' }
        Stop-OwnedService | Out-Null
        exit 0
    }
    if ($Mode -eq 'Remove') {
        if (-not $Elevated) { throw 'Service removal requires an administrator.' }
        $Service = Stop-OwnedService
        if ($Service) { & $Wrapper uninstall; if ($LASTEXITCODE -ne 0) { throw 'Windows service removal failed.' } }
        exit 0
    }
    if ($InstallService -and -not $Elevated) { throw 'Run Setup as administrator to register the Windows service.' }
    if (-not $StateDirectory) { throw 'StateDirectory is required.' }
    Protect-State $StateDirectory
    $Arguments = @((Join-Path $AppDirectory 'scripts\configure-service.js'),'--app-dir',$AppDirectory,'--state-dir',$StateDirectory,'--port',"$Port",'--host',$BindAddress,'--platform','win32')
    if ($StorageRoot) { $Arguments += @('--storage-root',$StorageRoot) }
    if ($RequireApiKey) { $Arguments += '--require-key' }
    & (Join-Path $AppDirectory 'runtime\node\node.exe') @Arguments
    if ($LASTEXITCODE -ne 0) { throw 'Service configuration failed. Check the selected paths and settings.' }
    $Configuration = Get-Content -LiteralPath (Join-Path $AppDirectory 'installation.json') -Raw | ConvertFrom-Json
    if ($InstallService) {
        foreach ($Directory in @($Configuration.storageRoot, (Split-Path $Configuration.catalogPath -Parent))) { Grant-ServiceStorage $Directory }
        $Address = if ($Configuration.host -eq 'localhost') { [Net.IPAddress]::Loopback } else { [Net.IPAddress]::Parse($Configuration.host) }
        $Listener = [Net.Sockets.TcpListener]::new($Address, $Configuration.port)
        try { $Listener.Start() } finally { $Listener.Stop() }
        $Service = Get-OwnedService
        if (-not $Service) { & $Wrapper install; if ($LASTEXITCODE -ne 0) { throw 'Windows service registration failed.' } }
        & $Wrapper start
        if ($LASTEXITCODE -ne 0) { throw 'Windows service startup failed. Inspect the logs in the state directory.' }
    }
    Write-Output 'Installation configured. Configuration, catalog, and terrain files are preserved by uninstall.'
    exit 0
} catch {
    Write-Error $_.Exception.Message -ErrorAction Continue
    exit 1
}