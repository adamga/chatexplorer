test('whole-source Ontario defaults to native packages and all grids keeps package options',async()=>{
  const catalog=new Catalog(':memory:');const calls=[];
  const registry=new SourceRegistry({defaultBufferMeters:0,maxDiscoveryAssets:1000,maxExportPixels:4096},catalog,{validateUrl(){}},{});
  registry.arcgisFeatures=async(endpoint,query,options)=>{calls.push(endpoint);assert.equal(!!options.wholeSource,wholeSource);return[{type:'Feature',geometry:polygon,properties:{DownloadLink:'https://example.gov/package.zip'}}];};
  let wholeSource=true;
  try {
    const whole=await registry.discover({sourceIds:['ontario'],scope:'source',products:['dtm']});
    assert.equal(whole.assetCount,1);assert.ok(calls.every(endpoint=>!endpoint.includes('ImageServer')));assert.equal(whole.assets[0].delivery,'packages');
    await assert.rejects(registry.discover({sourceIds:['ontario'],scope:'source',delivery:'export',products:['dtm']}),/require an area/);
    calls.length=0;
    wholeSource=false;
    const all=await registry.discover({sourceIds:['ontario'],bbox:[-79.5,43.5,-79.4,43.6],resolution:'all',products:['dtm']});
    assert.ok(calls.some(endpoint=>endpoint.includes('Ontario_Digital_Terrain_Model')));assert.ok(all.assets.some(asset=>asset.extension==='zip'));
  }finally{catalog.close();}
});