import assert from 'node:assert/strict';
import test from 'node:test';
import { assetsFromFeatures, builtInSources, ontarioExports, SourceRegistry } from '../src/sources.js';
import { normalizeBoundary } from '../src/spatial.js';
import { attributeLinks, canonicalDownloadUrl, geojsonFeatures } from '../src/indexes.js';
import { Catalog } from '../src/catalog.js';

const polygon = { type: 'Polygon', coordinates: [[[-79.5,43.5],[-79.4,43.5],[-79.4,43.6],[-79.5,43.6],[-79.5,43.5]]] };

test('catalog includes every plan source and source-native collection options', () => {
  const catalog = new Catalog(':memory:');
  try {
    const registry = new SourceRegistry({ defaultBufferMeters: 0 }, catalog, {}, {});
    for (const id of ['ontario','nrcan','pei','bc','quebec','alberta','nova-scotia','saskatchewan','usgs-3dep']) {
      const source = registry.get(id); const preset = registry.options(source).scorecarder;
      assert.ok(source); assert.equal(preset.scope, 'source'); assert.equal(preset.resolution, 'all');
      assert.deepEqual(preset.sourceIds, [id]); assert.equal(preset.prepareForScorecarder, true);
      assert.ok(!preset.products.includes('dsm')); assert.ok(!preset.collectionIds.includes('ontario-dtm-export'));
    }
    assert.deepEqual(registry.scorecarderAcquisition('ontario').collectionIds, ['ontario-dtm-packages']);
    assert.equal(registry.options(registry.get('derived')).scorecarder, null);
    catalog.saveSource({id:'cloud-only',name:'Clouds',adapter:'arcgis',coverageBbox:[-80,43,-79,44],collections:[{id:'clouds',products:['point-cloud'],formats:['laz']},{id:'surfaces',products:['dsm'],formats:['tif']}]});
    assert.deepEqual(registry.scorecarderAcquisition('cloud-only').products,['point-cloud']);
    assert.deepEqual(registry.scorecarderAcquisition('cloud-only').collectionIds,['clouds']);
    catalog.saveSource({id:'contour-only',name:'Contours',adapter:'arcgis',coverageBbox:[-80,43,-79,44],collections:[{id:'contours',products:['contours'],formats:['geojson']}]});
    assert.throws(()=>registry.scorecarderAcquisition('contour-only'),/no native ground/);
    assert.ok(registry.options(registry.get('usgs-3dep')).collections.some((collection) => collection.angularResolution === 1/9));
    assert.equal(registry.get('nrcan-pei').id, 'pei');
  } finally { catalog.close(); }
});

test('extracts actual BC spacing and link fields and Ontario HTML download links', () => {
  const source = builtInSources.find((source) => source.id === 'bc');
  const collection = source.collections.find((collection) => collection.id === 'bc-dtm-5');
  const assets = assetsFromFeatures([{ geometry: polygon, properties: { filename: 'native.tif', spacing: '1 metre', s3Url: 'https://nrs.objectstore.gov.bc.ca/example.tif' } }], source, collection);
  assert.equal(assets[0].resolutionMeters, 1);
  assert.equal(assets[0].product, 'dtm');
  assert.equal(attributeLinks({ Download: '<a href="https://example.gov/tile.laz">Download</a>' })[0].url, 'https://example.gov/tile.laz');
  assert.equal(canonicalDownloadUrl('https://download-telecharger.services.geo.ca/pub/example.tif'), 'https://ftp.maps.canada.ca/pub/example.tif');
});

test('Ontario exports split instead of silently coarsening a high-resolution request', () => {
  const source = builtInSources.find((source) => source.id === 'ontario');
  const query = normalizeBoundary({ bbox: [-79.5,43.5,-79.499,43.501] });
  const config = { maxExportPixels: 128, maxDiscoveryAssets: 1000 };
  const assets = ontarioExports(source, query, { resolution: 0.1 }, config);
  assert.ok(assets.length > 1);
  for (const asset of assets) {
    assert.ok(asset.width <= 128 && asset.height <= 128);
    assert.equal(asset.resolutionMeters, 0.5);
    assert.equal(asset.requestedResolutionMeters, 0.1);
    assert.equal(asset.resampled, true);
    assert.equal(new URL(asset.remoteUrl).searchParams.get('imageSR'), '32617');
  }
});

test('ArcGIS acquisition reads all IDs in batches instead of accepting a transfer cap', async () => {
  const catalog = new Catalog(':memory:');
  const counts = [];
  const network = { async json(input, options = {}) {
    const url = new URL(input);
    if (url.searchParams.get('returnIdsOnly')) {
      assert.equal(url.searchParams.has('geometry'), !wholeSource);
      return { objectIds: Array.from({ length: 1201 }, (value,index) => index + 1) };
    }
    assert.equal(options.method, 'POST');
    assert.equal(options.headers['Content-Type'], 'application/x-www-form-urlencoded');
    assert.equal(url.search, '');
    const ids = new URLSearchParams(options.body).get('objectIds').split(','); counts.push(ids.length);
    return { features: ids.map((id) => ({ type: 'Feature', id, geometry: polygon, properties: {} })) };
  } };
  let wholeSource = false;
  try {
    const registry = new SourceRegistry({ maxDiscoveryAssets: 2000 }, catalog, network, {});
    assert.equal((await registry.arcgisFeatures('https://example.gov/FeatureServer/0', normalizeBoundary({ bbox: [-80,43,-79,44] }))).length, 1201);
    assert.deepEqual(counts, [500,500,201]);
    wholeSource = true;
    assert.equal((await registry.arcgisFeatures('https://example.gov/FeatureServer/0', normalizeBoundary({ bbox: [-80,43,-79,44] }), { wholeSource })).length, 1201);
  } finally { catalog.close(); }
});

test('ImageServer footprints use its supported JSON response format', async () => {
  const catalog = new Catalog(':memory:');
  const network = { async json(input, options = {}) {
    const url = new URL(input);
    if (url.searchParams.get('returnIdsOnly')) return { objectIds: [1] };
    assert.equal(new URLSearchParams(options.body).get('f'), 'json');
    return { features: [{ attributes: { OBJECTID: 1 }, geometry: { rings: polygon.coordinates, spatialReference: { wkid: 4326 } } }] };
  } };
  try {
    const registry = new SourceRegistry({ maxDiscoveryAssets: 2000 }, catalog, network, {});
    const features = await registry.arcgisFeatures('https://example.gov/ImageServer', normalizeBoundary({ bbox: [-80,43,-79,44] }));
    assert.equal(features[0].geometry.type, 'Polygon');
  } finally { catalog.close(); }
});

test('NRCan coverage indexes accept single GeoJSON Features as well as collections', () => {
  const footprint = { type: 'Feature', properties: {}, geometry: polygon };
  assert.deepEqual(geojsonFeatures(footprint), [footprint]);
  assert.deepEqual(geojsonFeatures({ type: 'FeatureCollection', features: [footprint] }), [footprint]);
  assert.equal(geojsonFeatures(polygon)[0].geometry.type, 'Polygon');
});

