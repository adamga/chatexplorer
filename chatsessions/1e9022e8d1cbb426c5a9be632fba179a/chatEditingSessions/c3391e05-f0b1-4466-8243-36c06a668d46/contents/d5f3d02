import assert from 'node:assert/strict';
import test from 'node:test';
import path from 'node:path';
import os from 'node:os';
import { spawnSync } from 'node:child_process';
import { pathToFileURL } from 'node:url';
import { mkdtemp, rm, readFile, writeFile } from 'node:fs/promises';
import { Catalog } from '../src/catalog.js';
import { isContained, persistStorageRoot } from '../src/config.js';

test('SQLite catalog indexes local boundaries and keeps immutable source revisions', () => {
  const catalog = new Catalog(':memory:');
  try {
    const input = { sourceId: 'ontario', product: 'dtm', url: 'https://example.gov/a.tif', bbox: [-80, 43, -79, 44], resolutionMeters: 1 };
    const original = catalog.saveAsset(input);
    assert.equal(catalog.queryAssets({ bbox: [-79.5, 43.5, -79.4, 43.6] }).length, 0);
    catalog.markDownloaded(original.id, { path: path.resolve('test.tif'), bytes: 25000000000000, sha256: 'hash' });
    assert.equal(catalog.queryAssets({ bbox: [-79.5, 43.5, -79.4, 43.6] }).length, 1);
    assert.equal(catalog.queryAssets({ bbox: [-75, 43, -74, 44] }).length, 0);
    const rediscovered = catalog.saveAsset({ ...input, title: 'new metadata' });
    assert.equal(rediscovered.downloaded, true);
    const changed = catalog.saveAsset({ ...input, revision: 'v2' });
    assert.notEqual(changed.id, original.id);
    assert.equal(catalog.stats().bytes, 25000000000000);
  } finally { catalog.close(); }
});

test('courses, durable jobs, discovery plans, and asset links survive catalog operations', () => {
  const catalog = new Catalog(':memory:');
  try {
    const course = catalog.saveCourse({ id: 'heron-point', name: 'Heron Point', country: 'CA', province: 'ON', bbox: [-80, 43, -79, 44] });
    const asset = catalog.saveAsset({ sourceId: 'ontario', product: 'dtm', url: 'https://example.gov/a.tif', bbox: course.bbox, path: path.resolve('a.tif'), bytes: 123 });
    catalog.linkAsset(course.id, asset.id);
    assert.equal(catalog.courses('Heron')[0].assetCount, 1);
    assert.equal(catalog.courses('%').length, 0);
    const job = catalog.createJob('download', { assetIds: [asset.id] });
    catalog.updateJob(job.id, { status: 'running', progress: { completed: 1, total: 1, bytes: 123 } });
    catalog.event(job.id, 'Saved tile');
    assert.equal(catalog.job(job.id).status, 'running');
    assert.equal(catalog.events(job.id).length, 1);
    const plan = catalog.savePlan({ assetIds: [asset.id] });
    assert.deepEqual(catalog.plan(plan.id).assetIds, [asset.id]);
  } finally { catalog.close(); }
});

test('storage configuration persists in .env without removing unrelated settings', async () => {
  const directory = await mkdtemp(path.join(os.tmpdir(), 'terrain-config-'));
  try {
    const config = { envPath: path.join(directory, '.env') };
    await writeFile(config.envPath, 'PORT=3123\nAPI_KEY="example#value"\n');
    const root = path.join(directory, 'new storage');
    await persistStorageRoot(config, root);
    const text = await readFile(config.envPath, 'utf8');
    assert.match(text, /PORT="3123"/);
    assert.match(text, /API_KEY="example#value"/);
    assert.equal(config.storageRoot, root);
    assert.ok(isContained(root, path.join(root, 'a.tif')));
    assert.equal(isContained(root, path.join(root, '..', 'escape.tif')), false);
    await assert.rejects(persistStorageRoot(config, 'relative'), /absolute/);
  } finally { await rm(directory, { recursive: true, force: true }); }
});

test('installed services use an external authoritative config and data paths without changing program files',async()=>{
  const directory=await mkdtemp(path.join(os.tmpdir(),'terrain-service-config-'));
  try {
    const filename=path.join(directory,'service.env');await writeFile(filename,'HOST=127.0.0.1\nPORT=3199\nSTORAGE_ROOT=./terrain\nCATALOG_PATH=./catalog.sqlite\n');
    const script=`import {loadConfig} from ${JSON.stringify(pathToFileURL(path.resolve('src/config.js')).href)};const config=loadConfig();console.log(JSON.stringify({port:config.port,envPath:config.envPath,storageRoot:config.storageRoot,catalogPath:config.catalogPath}));`;
    const result=spawnSync(process.execPath,['--input-type=module','-e',script],{encoding:'utf8',env:{...process.env,TERRAIN_CONFIG_PATH:filename,PORT:'9999'}});
    assert.equal(result.status,0,result.stderr);const config=JSON.parse(result.stdout);assert.equal(config.port,3199);assert.equal(config.envPath,filename);assert.equal(config.storageRoot,path.join(directory,'terrain'));assert.equal(config.catalogPath,path.join(directory,'catalog.sqlite'));
    const missing=spawnSync(process.execPath,['--input-type=module','-e',script],{encoding:'utf8',env:{...process.env,TERRAIN_CONFIG_PATH:path.join(directory,'missing.env')}});assert.notEqual(missing.status,0);assert.match(missing.stderr,/does not exist/);
  }finally{await rm(directory,{recursive:true,force:true});}
});