  if(!catalog.setting('lastUpdateCheck'))catalog.setSetting('lastUpdateCheck',new Date().toISOString());
  const updateTimer=config.updateCheckDays>0?setInterval(()=>{const last=Date.parse(catalog.setting('lastUpdateCheck'));if(Date.now()-last>config.updateCheckDays*86400000&&!catalog.jobs().some(job=>job.type==='updates'&&['running','queued'].includes(job.status)))jobs.enqueue('updates',{});},3600000):null;updateTimer?.unref();
