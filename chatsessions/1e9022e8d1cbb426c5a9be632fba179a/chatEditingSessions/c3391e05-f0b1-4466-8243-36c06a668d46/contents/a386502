#!/usr/bin/env bash
set -euo pipefail
LINE=$(awk '$0 == "__TERRAIN_PAYLOAD_BELOW__" { print NR+1; exit }' "$0")
if [[ -z "$LINE" ]]; then printf '%s\n' 'Installer payload marker is missing.' >&2; exit 1; fi
TEMP_DIRECTORY=$(mktemp -d -t terrainserver-setup-XXXXXXXX)
trap 'rm -rf -- "$TEMP_DIRECTORY"' EXIT
tail -n "+$LINE" "$0" | tar -xzf - --no-same-owner -C "$TEMP_DIRECTORY"
bash "$TEMP_DIRECTORY/installer/linux/install.sh" --package-root "$TEMP_DIRECTORY" "$@"
exit $?
__TERRAIN_PAYLOAD_BELOW__