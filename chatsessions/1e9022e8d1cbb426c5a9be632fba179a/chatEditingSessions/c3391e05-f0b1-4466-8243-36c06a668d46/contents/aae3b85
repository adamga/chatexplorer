  const extracted=path.join(buildRoot,'node-extracted');await rm(extracted,{recursive:true,force:true});await mkdir(extracted,{recursive:true});
  if(windows)await (await unzipper.Open.file(archive)).extract({path:extracted});else await run('tar',['-xf',archive,'-C',extracted],{capture:true});
