  const checksums=await fetch(`https://nodejs.org/dist/${version}/SHASUMS256.txt`,{signal:AbortSignal.timeout(60000)}).then(response=>{if(!response.ok)throw new Error('Cannot read official Node.js checksums.');return response.text();});
