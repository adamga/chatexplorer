    await writeFile(path.join(directory,'PACKAGE.json'),JSON.stringify(metadata,null,2)+'\n');
    if(sourceFiles.length)await writeFile(path.join(sourceRoot,record.name,'PACKAGE.json'),JSON.stringify(metadata,null,2)+'\n');
    total+=licenseMembers.length;
  }
  const {version}=JSON.parse(await readFile(path.join(root,'package.json'),'utf8'));const sourceBundle=path.join(output,`TerrainServer-${version}-${targetLabel}-gis-sources.tar.gz`);
  await run('tar',['-czf',sourceBundle,'-C',sourceRoot,'.']);await writeFile(sourceBundle+'.sha256',`${await hash(sourceBundle)}  ${path.basename(sourceBundle)}\n`);
  console.log(`Included ${total} GIS license files with original package recipes and source references.`);
}
