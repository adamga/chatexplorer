    const licenseMembers=members.filter(filename=>filename.startsWith('info/licenses/')&&!filename.endsWith('/'));
    const directory=path.join(stage,'third-party','gis',record.name);await mkdir(directory,{recursive:true});
    if(members.length)await run('tar',['-xf',infoArchive,'-C',directory,...members],{capture:true});
    const runtime=(record.files||[]).some(filename=>/\.(dll|exe)$|\.so(?:\.[^/]*)?$|^(Library\/)?share\/(gdal|proj)/i.test(filename));
    let sourceFiles=[];
    if(record.name!=='ucrt'&&(!licenseMembers.length&&runtime||/\b[AL]?GPL|MPL|copyleft/i.test(record.license||''))){
      const recipeDirectory=path.join(directory,'info/recipe');
      const recipeFilename=['meta.yaml','rendered_recipe.yaml'].find(filename=>members.includes(`info/recipe/${filename}`));
      if(!recipeFilename)throw new Error(`Package source recipe not found: ${record.name}`);
      const parsedRecipe=parseYaml(await readFile(path.join(recipeDirectory,recipeFilename),'utf8'));const recipe=parsedRecipe.recipe||parsedRecipe;
      const sources=Array.isArray(recipe.source)?recipe.source:[recipe.source];
      for(const [index,source] of sources.entries()){
        if(!source)continue;const urls=Array.isArray(source.url)?source.url:[source.url];
        if(!urls[0]||!source.sha256)throw new Error(`Cannot verify corresponding source for ${record.name}.`);
        const name=path.basename(new URL(urls[0]).pathname);
        const candidates=[...new Set([...urls.map(url=>url.replace(/^http:/,'https:')),`https://sources.buildroot.net/${record.name}/${name}`,`https://distfiles.macports.org/${record.name}/${name}`])];let sourceArchive,url;const errors=[];
