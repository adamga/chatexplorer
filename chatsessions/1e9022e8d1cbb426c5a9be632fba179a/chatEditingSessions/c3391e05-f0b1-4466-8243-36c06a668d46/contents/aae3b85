    const child=spawn(executable,args,{cwd:root,windowsHide:true,stdio:options.capture?'pipe':'inherit',...options});let stdout='',stderr='';
    child.stdout?.on('data',chunk=>{stdout+=chunk;});child.stderr?.on('data',chunk=>{stderr+=chunk;});
    child.once('error',reject);child.once('exit',code=>{if(code!==0&&!options.allowFailure)reject(new Error(`${path.basename(executable)} exited ${code}: ${stderr||stdout}`));else resolve({code,stdout,stderr});});
