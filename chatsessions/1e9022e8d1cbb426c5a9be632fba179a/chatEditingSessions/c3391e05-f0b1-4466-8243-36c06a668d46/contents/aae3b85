        if(!sourceArchive)throw new Error(`Cannot recover verified ${record.name} source: ${errors.join('; ')}`);
        const sourceDirectory=path.join(sourceRoot,record.name);await mkdir(sourceDirectory,{recursive:true});const sharedDirectory=path.join(sourceRoot,'archives');await mkdir(sharedDirectory,{recursive:true});const sharedFilename=`${source.sha256}-${name}`;if(!await access(path.join(sharedDirectory,sharedFilename)).then(()=>true,()=>false))await copyFile(sourceArchive,path.join(sharedDirectory,sharedFilename));sourceFiles.push({url,sha256:source.sha256,filename:`../archives/${sharedFilename}`});
        if(!licenseMembers.length){
          const sourceListing=await run('tar',['-tf',sourceArchive],{capture:true});
          const notices=sourceListing.stdout.split(/\r?\n/).filter(filename=>/(^|\/)(COPYING(?:\.[^/]*)?|LICENSE(?:\.[^/]*)?|COPYRIGHT(?:\.[^/]*)?|NOTICE(?:\.[^/]*)?)$/i.test(filename)&&!filename.split('/').includes('..')&&!filename.includes('\\'));
          if(notices.length){await run('tar',['-xf',sourceArchive,'-C',directory,...notices],{capture:true});licenseMembers.push(...notices);}
