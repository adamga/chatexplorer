    const values=Array.from({length:100},(value,index)=>100+index);
    const bytes=Buffer.from(writeArrayBuffer(values,{width:10,height:10,BitsPerSample:[8],SampleFormat:[1],ModelPixelScale:[0.001,0.001,0],ModelTiepoint:[0,0,0,-79.5,43.6,0],GeographicTypeGeoKey:4326,GTModelTypeGeoKey:2,GTRasterTypeGeoKey:1,GDAL_NODATA:'255'}));
    const filename=path.join(root,'fixture.tif');await writeFile(filename,bytes);
    const asset=service.catalog.saveAsset({sourceId:'ontario',title:'Fixture Raster',product:'dtm',extension:'tif',path:filename,bbox:[-79.5,43.59,-79.49,43.6],resolutionMeters:1,bytes:bytes.length,sha256:'fixture-hash'});service.catalog.linkAsset('fixture',asset.id);
    for(const product of ['hillshade','slope']){const visual=service.catalog.saveAsset({sourceId:'derived',title:`Visualization ${product}`,product,extension:'tif',url:`https://example.gov/${product}.tif`,path:filename,bbox:asset.bbox,resolutionMeters:1,bytes:bytes.length});service.catalog.linkAsset('fixture',visual.id);}
    const binary=await request(service.app).get(`/api/assets/${asset.id}/download.tif`).set('Range','bytes=0-7').expect(206);assert.equal(binary.headers['content-range'],`bytes 0-7/${bytes.length}`);
    const manifest=await request(service.app).get('/api/scorecarder/manifest?bbox=-79.5,43.59,-79.49,43.6').expect(200);assert.equal(manifest.body.assets.length,1);assert.ok(manifest.body.assets[0].url.endsWith('.tif'));assert.equal(manifest.body.assets[0].bbox.minLng,-79.5);
    await request(service.app).get('/api/course/fixture/manifest').expect(200).then(result=>assert.deepEqual(result.body.assets.map(value=>value.product),['dtm']));
    const arcgis=await request(service.app).get('/api/scorecarder/query').query({geometry:JSON.stringify({xmin:-79.5,ymin:43.59,xmax:-79.49,ymax:43.6})}).expect(200);assert.equal(arcgis.body.features.length,1);assert.ok(arcgis.body.features[0].attributes.downloadUrl.endsWith('.tif'));
    const stac=await request(service.app).post('/api/stac/search').send({bbox:[-79.5,43.59,-79.49,43.6],collections:['ontario']}).expect(200);assert.equal(stac.body.features.length,1);
    const genericStac=await request(service.app).post('/api/stac/search').send({bbox:asset.bbox}).expect(200);assert.equal(genericStac.body.features.length,3);
    const elevationStac=await request(service.app).post('/api/scorecarder/stac/search').send({bbox:asset.bbox}).expect(200);assert.equal(elevationStac.body.features.length,1);assert.equal(elevationStac.body.features[0].properties['terrain:product'],'dtm');assert.match(elevationStac.body.features[0].links[0].href,/\/api\/scorecarder\/stac\/items\//);
    const visualId=genericStac.body.features.find(value=>value.properties['terrain:product']==='hillshade').id;await request(service.app).get(`/api/scorecarder/stac/items/${visualId}`).expect(404);
    await request(service.app).get('/api/scorecarder/stac/collections/derived/items').expect(200).then(result=>assert.equal(result.body.features.length,0));
    await request(service.app).get('/api/stac/collections/ontario/items').expect(200).then(result=>assert.equal(result.body.features.length,1));
    await request(service.app).get('/api/stac/collections/derived').expect(200);
