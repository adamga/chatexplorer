test('API authentication, CORS origin checks, and DNS-rebinding Host protection',async()=>{
  const root=await mkdtemp(path.join(os.tmpdir(),'terrain-auth-'));const service=await createService({storageRoot:root,catalogPath:':memory:',apiKey:'test-key',updateCheckDays:0,startJobs:false});
  try{
    await request(service.app).get('/api/settings').expect(401);
    await request(service.app).get('/api/settings').set('Authorization','Bearer test-key').expect(200);
    await request(service.app).post('/api/courses').set('Authorization','Bearer test-key').set('Origin','https://untrusted.example').send({}).expect(403);
