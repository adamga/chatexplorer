    await request(service.app).get('/api/health').expect(200);
  }finally{await service.close();await rm(root,{recursive:true,force:true});}
});

test('one-source Scorecarder acquisition unpacks ZIPs and converts IMG into locally served native GeoTIFFs',async()=>{
  const root=await mkdtemp(path.join(os.tmpdir(),'terrain-preset-'));
  const repository=path.join(root,'chosen-repository');const extent=[-79.5,43.59,-79.49,43.6];
  const bytes=Buffer.from(writeArrayBuffer(new Uint8Array(100).fill(100),{width:10,height:10,BitsPerSample:[8],SampleFormat:[1],ModelPixelScale:[0.001,0.001,0],ModelTiepoint:[0,0,0,-79.5,43.6,0],GeographicTypeGeoKey:4326,GTModelTypeGeoKey:2,GTRasterTypeGeoKey:1}));
  const archive=storedArchive('tiles/native.tif',bytes);const requests=[];let image;let downloads=0;
  const server=createServer(async(incoming,response)=>{
    const url=new URL(incoming.url,'http://localhost');
    if(url.pathname==='/native.zip'||url.pathname==='/native.img'){downloads++;const content=url.pathname.endsWith('.zip')?archive:image;response.writeHead(200,{'Content-Length':content.length,ETag:'"preset-fixture"'});response.end(content);return;}
    const chunks=[];for await(const chunk of incoming)chunks.push(chunk);
    const parameters=incoming.method==='POST'?new URLSearchParams(Buffer.concat(chunks).toString()):url.searchParams;requests.push({method:incoming.method,parameters});
    const provider=`http://127.0.0.1:${server.address().port}`;
    const result=parameters.get('returnIdsOnly')?{objectIds:[1]}:{type:'FeatureCollection',features:[{type:'Feature',geometry:{type:'Polygon',coordinates:[[[-79.5,43.59],[-79.49,43.59],[-79.49,43.6],[-79.5,43.6],[-79.5,43.59]]]},properties:{DownloadLink:`${provider}/native.zip`,ImageLink:`${provider}/native.img`,Resolution:1}}]};
    response.writeHead(200,{'Content-Type':'application/json'});response.end(JSON.stringify(result));
  });
  await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));
  const service=await createService({storageRoot:path.join(root,'default'),catalogPath:':memory:',updateCheckDays:0,startJobs:false,allowPrivateDownloadHosts:true,minFreeDiskGb:0});
  try {
    const input=path.join(root,'original.tif');const img=path.join(root,'original.img');await writeFile(input,bytes);
    await service.gis.run('gdal_translate',['-of','HFA',input,img]);image=await readFile(img);
    service.registry.register({id:'preset-fixture',name:'Preset Fixture',adapter:'arcgis',country:'CA',region:'ON',coverageBbox:extent,
      license:{title:'Fixture licence',url:'https://example.gov/licence'},collections:[{id:'native-ground',products:['dtm'],formats:['zip','img'],endpoint:`http://127.0.0.1:${server.address().port}/FeatureServer/0`},{id:'surface-only',products:['dsm'],formats:['tif'],endpoint:`http://127.0.0.1:${server.address().port}/SurfaceServer/0`}]});
    await request(service.app).post('/api/sources/preset-fixture/acquire').send({storageRoot:repository,products:['dsm']}).expect(400);
    const settled=once(service.jobs,'settled');const queued=await request(service.app).post('/api/sources/preset-fixture/acquire').send({storageRoot:repository}).expect(202);await settled;
    const job=service.catalog.job(queued.body.id);assert.equal(job.status,'completed',job.error);assert.equal(job.progress.result.scorecarder.readyAssets,2);
    assert.deepEqual(job.payload.products,['dtm']);assert.equal(job.payload.storageRoot,repository);assert.equal(job.payload.processAfterDownload,false);
    assert.equal(requests[0].parameters.has('geometry'),false);assert.equal(requests[1].method,'POST');
    const manifest=await request(service.app).get('/api/scorecarder/manifest').query({sources:'preset-fixture'}).expect(200);assert.equal(manifest.body.assets.length,2);
    for(const asset of manifest.body.assets){assert.equal(asset.extension,'tif');assert.deepEqual(asset.pixelSize,[0.001,0.001]);await request(service.app).get(`/api/assets/${asset.id}/download.tif`).set('Range','bytes=0-7').expect(206);}
    const local=service.catalog.queryAssets({sourceIds:['preset-fixture'],localOnly:true});assert.equal(local.length,4);assert.ok(local.every(asset=>asset.path.startsWith(repository)));
    const again=once(service.jobs,'settled');const retry=await request(service.app).post('/api/sources/preset-fixture/acquire').send({storageRoot:repository}).expect(202);await again;
    assert.equal(service.catalog.job(retry.body.id).status,'completed');assert.equal(downloads,2);assert.equal(service.catalog.queryAssets({sourceIds:['preset-fixture'],localOnly:true}).length,4);
  }finally{await service.close();await new Promise(resolve=>server.close(resolve));await rm(root,{recursive:true,force:true});}
});

test('large raster display chooses a native internal overview before reading pixels',async()=>{
  const reference={getOrigin:()=>[0,10,0],getResolution:()=>[0.001,-0.001,0],getWidth:()=>10000,getHeight:()=>10000,fileDirectory:{}};
  const overview={getResolution:()=>[0.016,-0.016,0],getWidth:()=>625,getHeight:()=>625,fileDirectory:{NewSubfileType:1}};
  const tiff={getImageCount:async()=>2,getImage:async index=>index?overview:reference};
  const selected=await gridImage(tiff,reference,[0,0,10,10],'EPSG:4326',256,256);
  assert.equal(selected.image,overview);assert.equal(selected.overview,true);assert.ok((selected.window[2]-selected.window[0])*(selected.window[3]-selected.window[1])<1000000);
});

