import { area, bbox, bboxPolygon, booleanIntersects, buffer, difference, intersect, feature, featureCollection } from '@turf/turf';

export class HttpError extends Error {
  constructor(status, message, details) {
    super(message);
    this.status = status;
    this.details = details;
  }
}

export function parseBbox(input) {
  const values = typeof input === 'string' ? input.split(',').map(Number)
    : Array.isArray(input) ? input.map(Number)
      : input && [input.minLng ?? input.west, input.minLat ?? input.south, input.maxLng ?? input.east, input.maxLat ?? input.north].map(Number);
  if (!values || values.length !== 4 || !values.every(Number.isFinite)) {
    throw new HttpError(400, 'bbox must contain west,south,east,north in WGS84 longitude/latitude.');
  }
  const [west, south, east, north] = values;
  if (west < -180 || east > 180 || south < -90 || north > 90 || west >= east || south >= north) {
    throw new HttpError(400, 'Invalid bbox. Split antimeridian-crossing requests into separate boundaries.');
  }
  return values;
}

export function normalizeBoundary(input, defaultBuffer = 0) {
  let boundary;
  if (input.boundary) {
    boundary = input.boundary.type === 'Feature' ? structuredClone(input.boundary) : feature(input.boundary);
    if (!['Polygon', 'MultiPolygon'].includes(boundary.geometry?.type)) {
      throw new HttpError(400, 'boundary must be a WGS84 GeoJSON Polygon or MultiPolygon.');
    }
    const rings = boundary.geometry.type === 'Polygon' ? boundary.geometry.coordinates : boundary.geometry.coordinates.flat();
    let points = 0;
    for (const ring of rings) {
      if (!Array.isArray(ring) || ring.length < 4 || JSON.stringify(ring[0]) !== JSON.stringify(ring.at(-1))) {
        throw new HttpError(400, 'GeoJSON polygon rings must be closed and contain at least four coordinates.');
      }
      for (const coordinate of ring) {
        if (!Array.isArray(coordinate) || coordinate.length < 2 || !coordinate.slice(0, 2).every(Number.isFinite)
          || Math.abs(coordinate[0]) > 180 || Math.abs(coordinate[1]) > 90) {
          throw new HttpError(400, 'GeoJSON coordinates must be numeric WGS84 longitude/latitude.');
        }
        if (++points > 100000) throw new HttpError(400, 'Boundary exceeds 100,000 coordinates.');
      }
    }
  } else {
    boundary = bboxPolygon(parseBbox(input.bbox));
  }
  const bufferMeters = Number(input.bufferMeters ?? defaultBuffer);
  if (!Number.isFinite(bufferMeters) || bufferMeters < 0 || bufferMeters > 10000) {
    throw new HttpError(400, 'bufferMeters must be between 0 and 10,000.');
  }
  const queryBoundary = bufferMeters ? buffer(boundary, bufferMeters, { units: 'meters' }) : boundary;
  const extent = parseBbox(bbox(queryBoundary));
  return { boundary, queryBoundary, bbox: extent, bufferMeters, areaKm2: area(queryBoundary) / 1000000 };
}

export function intersectsBoundary(asset, query) {
  if (!asset.bbox && !asset.geometry) return false;
  const geometry = asset.geometry ? feature(asset.geometry) : bboxPolygon(parseBbox(asset.bbox));
  return booleanIntersects(geometry, query.queryBoundary);
}

export function selectAssets(assets, query, options = {}) {
  const products = options.products?.length ? options.products : null;
  const filtered = assets.filter((asset) => intersectsBoundary(asset, query)
    && (!products || products.includes(asset.product))
    && (!options.formats?.length || options.formats.includes(asset.extension))
    && (!options.collectionIds?.length || options.collectionIds.includes(asset.collectionId)));
  const resolution = options.resolution ?? 'all';
  if (resolution === 'best') {
    const groups = new Map();
    const rank = (asset) => asset.resolutionMeters || (asset.angularResolution ? asset.angularResolution * 111320 / 3600 : null);
    for (const asset of filtered) {
      const key = `${asset.sourceId}:${asset.product}`;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(asset);
    }
    return filtered.filter((asset) => {
      if (!rank(asset)) return true;
      const finer = groups.get(`${asset.sourceId}:${asset.product}`).filter((other) => rank(other) && rank(other) < rank(asset) && intersectsBoundary(other, { queryBoundary: asset.geometry ? feature(asset.geometry) : bboxPolygon(asset.bbox) }));
      if (!finer.length) return true;
      const shape = asset.geometry ? feature(asset.geometry) : bboxPolygon(asset.bbox);
      const clipped = intersect(featureCollection([shape, query.queryBoundary]));
      if (!clipped) return true;
      return difference(featureCollection([clipped, ...finer.map((other) => other.geometry ? feature(other.geometry) : bboxPolygon(other.bbox))])) !== null;
    });
  }
  if (resolution === 'all' || resolution === 'native') return filtered;
  const numeric = Number(resolution);
  if (!(numeric > 0) || !Number.isFinite(numeric)) throw new HttpError(400, 'resolution must be best, all, native, or a positive number in meters.');
  return filtered.filter((asset) => asset.resolutionMeters === numeric || asset.requestedResolutionMeters === numeric);
}

export function metricCrs(extent) {
  const [west, south, east, north] = parseBbox(extent);
  const longitude = (west + east) / 2;
  const latitude = (south + north) / 2;
  if (latitude < -80 || latitude > 84) return latitude >= 0 ? 'EPSG:3413' : 'EPSG:3031';
  const zone = Math.max(1, Math.min(60, Math.floor((longitude + 180) / 6) + 1));
  return `EPSG:${(latitude >= 0 ? 32600 : 32700) + zone}`;
}

export function assetsGeojson(assets) {
  return featureCollection(assets.filter((asset) => asset.geometry || asset.bbox).map((asset) => {
    const shape = asset.geometry ? feature(asset.geometry) : bboxPolygon(asset.bbox);
    shape.properties = { id: asset.id, sourceId: asset.sourceId, product: asset.product, resolutionMeters: asset.resolutionMeters, downloaded: asset.downloaded };
    return shape;
  }));
}