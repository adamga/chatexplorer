import { EventEmitter } from 'node:events';
import path from 'node:path';
import { mkdir, stat, statfs, writeFile, realpath } from 'node:fs/promises';
import { createReadStream, createWriteStream } from 'node:fs';
import { pipeline } from 'node:stream/promises';
import { Transform } from 'node:stream';
import { createHash } from 'node:crypto';
import { courseDirectory, isContained, safeSegment } from './config.js';
import { HttpError } from './spatial.js';
import { publishFile } from './network.js';
import { rasterMetadata } from './processing.js';

export class JobManager extends EventEmitter {
  constructor(config, catalog, network, registry, processor) {
    super(); this.config = config; this.catalog = catalog; this.network = network; this.registry = registry; this.processor = processor;
    this.stopped = false; this.draining = false; this.active = null;
    this.catalog.db.prepare("UPDATE jobs SET status='queued',error='Interrupted by restart; resuming' WHERE status='running'").run();
  }

  enqueue(type, payload) {
    if (!['discover','download','acquire','process','extract','refresh','updates'].includes(type)) throw new HttpError(400, 'Unknown job type.');
    const job = this.catalog.createJob(type, { ...payload, storageRoot: payload.storageRoot || this.config.storageRoot });
    this.catalog.event(job.id, `Queued ${type}`); this.emit('change', job.id); this.wake(); return job;
  }

  wake() {
    if (this.draining || this.stopped) return;
    this.draining = true;
    this.task = Promise.resolve().then(() => this.drain()).finally(() => { this.draining = false; this.emit('idle'); if (!this.stopped && this.catalog.pendingJob()) this.wake(); });
  }

  async drain() {
    while (!this.stopped) {
      const job = this.catalog.pendingJob(); if (!job) return;
      const controller = new AbortController(); this.active = { id: job.id, controller, cancelled: false };
      this.catalog.updateJob(job.id, { status: 'running', error: null });
      const context = { id: job.id, signal: controller.signal, event: (message,level) => { this.catalog.event(job.id,message,level); this.emit('change',job.id); },
        onProgress: (progress) => { this.catalog.updateJob(job.id,{ progress: { ...this.catalog.job(job.id).progress, ...progress } }); this.emit('change',job.id); } };
      try {
        await mkdir(job.payload.storageRoot, { recursive: true }); this.catalog.registerRoot(job.payload.storageRoot);
        let result;
        if (job.type === 'discover') { const plan = await this.registry.discover(job.payload, { ...context, onProgress: (message) => context.onProgress({ stage: 'discovery', message }) }); result = { planId: plan.id, completed: plan.assetCount, total: plan.assetCount, partial: !plan.complete }; }
        else if (job.type === 'acquire') {
          let plan = job.progress.planId ? this.catalog.plan(job.progress.planId) : null;
          if (!plan?.complete) plan = await this.registry.discover(job.payload, { ...context, onProgress: (message) => context.onProgress({ stage: 'discovery', message }) });
          context.onProgress({ planId: plan.id }); result = await this.downloadPlan({ ...job.payload, planId: plan.id }, context);
        } else if (job.type === 'download') result = await this.downloadPlan(job.payload, context);
        else if (job.type === 'process') result = await this.processor.process(job.payload, context);
        else if (job.type === 'extract') result = { assetIds: await this.processor.expandArchives(job.payload.assetIds, context) };
        else if (job.type === 'refresh') {
          const ids = job.payload.sourceIds?.length ? job.payload.sourceIds : this.registry.list().map((source) => source.id);
          for (let index = 0; index < ids.length; index++) { await this.registry.refresh(ids[index], context); context.onProgress({ completed:index+1,total:ids.length,stage:'catalog refresh' }); }
          result = { sourceIds: ids };
        } else result = await this.checkUpdates(job.payload, context);
        this.catalog.updateJob(job.id, { status: 'completed', progress: { ...this.catalog.job(job.id).progress, result } }); context.event('Job completed');
      } catch (error) {
        const status = this.stopped ? 'queued' : this.active.cancelled ? 'cancelled' : 'failed';
        this.catalog.updateJob(job.id, { status, error: error.message || 'Job interrupted.' }); context.event(error.message || 'Job interrupted.', status === 'failed' ? 'error' : 'warning');
      } finally { this.active = null; this.emit('settled',this.catalog.job(job.id)); this.emit('change',job.id); }
    }
  }

  cancel(id) {
    const job = this.catalog.job(id); if (!job) throw new HttpError(404, 'Job not found.');
    if (!['queued','running'].includes(job.status)) throw new HttpError(409, 'Only queued or running jobs can be cancelled.');
    if (this.active?.id === id) { this.active.cancelled = true; this.active.controller.abort(new Error('Cancelled by user; partial files retained.')); }
    else this.catalog.updateJob(id,{status:'cancelled'});
    this.emit('change',id); return this.catalog.job(id);
  }

  async stop() { this.stopped = true; this.active?.controller.abort(new Error('Service shutting down; job will resume at restart.')); await this.task; }

  async downloadPlan(payload, context) {
    const plan = payload.planId ? this.catalog.plan(payload.planId) : null;
    if (payload.planId && !plan) throw new HttpError(404, 'Acquisition plan not found.');
    if (plan && !plan.complete && !payload.allowPartial) throw new HttpError(409, `Discovery is incomplete. ${(plan.errors||[]).map(error=>`${error.collectionId||error.sourceId}: ${error.message}`).join('; ')} Resolve provider errors or explicitly set allowPartial=true.`);
    const ids = payload.assetIds?.length ? payload.assetIds : plan?.assetIds;
    if (!ids?.length) throw new HttpError(400, payload.prepareForScorecarder ? 'No anonymously downloadable native ground-elevation data was found. Check provider coverage, permissions, and the acquisition plan.' : 'No assets were selected for download.');
    if (plan && ids.some((id) => !plan.assetIds.includes(id))) throw new HttpError(400, 'Selected assets are not in this acquisition plan.');
    const course = payload.courseId ? this.catalog.course(payload.courseId) : null;
    if (payload.courseId && !course) throw new HttpError(404, 'Course not found.');
    const root = payload.storageRoot || this.config.storageRoot;
    await mkdir(root, { recursive: true });
    const disk = await statfs(root);
    if (Number(disk.bavail) * Number(disk.bsize) < this.config.minFreeDiskGb * 1024 ** 3) throw new HttpError(507, 'Storage has less free space than MIN_FREE_DISK_GB.');
    let position = 0; let completed = 0; let failed = 0; let completedBytes = 0; let existingBytes = 0; let lastProgress = 0; let readyAssets = 0; let reused = 0; let resumed = 0;
    const transfers = new Map(); const failures = [];
    const progress = (force = false) => {
      if (!force && Date.now() - lastProgress < 500) return; lastProgress = Date.now();
      context.onProgress({ stage:'download',message:'',completed,total:ids.length,failed,bytes:completedBytes + [...transfers.values()].reduce((sum,item) => sum + item.bytes - (item.resumedBytes || 0),0),
        transfers:[...transfers.values()],planId:plan?.id,storageRoot:root,reused,resumed,existingBytes,...(payload.prepareForScorecarder ? { readyAssets } : {}) });
    };
    const worker = async () => {
      while (position < ids.length) {
        context.signal.throwIfAborted(); const index = position++; const asset = this.catalog.asset(ids[index]);
        try {
          if (!asset?.remoteUrl && !asset?.downloaded) throw new HttpError(400, 'Asset has no downloadable URL.');
          const destinationRoot = courseDirectory(root, course || { id:'repository',country:asset.country,province:asset.region });
          const category = asset.product === 'point-cloud' ? 'lidar' : ['dtm','dem','dsm'].includes(asset.product) ? 'dem' : safeSegment(asset.product);
          const destination = path.join(destinationRoot,category,'raw',`${safeSegment(asset.sourceId)}-${asset.id}.${asset.extension}`);
          await mkdir(path.dirname(destination),{recursive:true});
          if (!isContained(await realpath(root),await realpath(path.dirname(destination)))) throw new HttpError(400,'Storage path escapes its root through a symbolic link.');
          context.event(`Checking existing package ${index+1}/${ids.length}: ${asset.title || asset.id}`);
          const onProgress = (item) => { transfers.set(asset.id,{id:asset.id,title:asset.title,...item}); progress(); };
          let result;
          const local = asset.downloaded ? await stat(asset.path).catch((error) => { if (error.code === 'ENOENT') return null; throw error; }) : null;
          if (local && path.resolve(asset.path) !== path.resolve(destination)) {
            const existing = await stat(destination).catch((error) => { if(error.code === 'ENOENT') return null; throw error; });
            if (!existing) {
              const temporary = `${destination}.copy-${context.id}.part`; const hash = createHash('sha256'); let bytes = 0;
              const measure = new Transform({ transform(chunk,encoding,callback) { bytes += chunk.length; hash.update(chunk); onProgress({bytes,total:local.size}); callback(null,chunk); } });
              await pipeline(createReadStream(asset.path),measure,createWriteStream(temporary,{flags:'w'}),{signal:context.signal});
              const sha256 = hash.digest('hex'); if (asset.sha256 && sha256 !== asset.sha256) throw new HttpError(409,'Cached source checksum changed; refusing to propagate altered data.');
              await publishFile(temporary,destination); result = {path:destination,bytes,sha256,etag:asset.etag,lastModified:asset.lastModified};
            } else {
              if (existing.size !== asset.bytes) throw new HttpError(409,'Destination contains a different raw file; no overwrite was performed.');
              result = {path:destination,bytes:existing.size,sha256:asset.sha256,etag:asset.etag,lastModified:asset.lastModified};
            }
          } else result = await this.network.download(asset.remoteUrl,destination,{signal:context.signal,extension:asset.extension,expectedBytes:asset.expectedBytes,sha256:asset.providerSha256,
            cachedAsset:asset,diskRoot:root,onProgress,onRetry:(attempt,error) => context.event(`Retry ${attempt}: ${error.message}`,'warning')});
          if (result.reused) { reused++; context.event(`Reusing completed package: ${asset.title || asset.id}`); }
          else if (result.resumedBytes) { resumed++; context.event(`Resumed ${asset.title || asset.id} from ${result.resumedBytes.toLocaleString()} bytes`); }
          this.catalog.markDownloaded(asset.id,result);
          if (['tif','tiff'].includes(asset.extension) && (!result.reused || !asset.pixelSize)) {
            const metadata = await rasterMetadata(result.path);
            this.catalog.saveAsset({...this.catalog.asset(asset.id),...metadata,path:result.path,bytes:result.bytes,sha256:result.sha256});
          }
          if (payload.prepareForScorecarder) {
            context.onProgress({ stage:'preparation',message:`Preparing ${asset.title || asset.id} for Scorecarder` });
            const prepared = await this.processor.prepareForScorecarder([asset.id], context);
            for (const preparedId of prepared) this.catalog.linkAsset(course?.id, preparedId);
            readyAssets += prepared.length;
            context.event(`${prepared.length.toLocaleString()} local elevation file(s) ready for Scorecarder`);
          }
          this.catalog.linkAsset(course?.id,asset.id); completed++; completedBytes += result.reused ? 0 : result.bytes - (result.resumedBytes || 0); existingBytes += result.reused ? result.bytes : result.resumedBytes || 0;
          transfers.delete(asset.id); context.event(`Stored ${asset.title || asset.id} (${result.bytes.toLocaleString()} bytes)`); progress(true);
          if (course) await writeFile(path.join(destinationRoot,'metadata.json'),JSON.stringify(this.catalog.course(course.id),null,2));
        } catch(error) {
          if(context.signal.aborted) throw error; failed++; transfers.delete(asset?.id); if(failures.length<100) failures.push({id:asset?.id,message:error.message});
          context.event(`${asset?.id}: ${error.message}`,'error'); progress(true);
          if(error.status===507 || error.code==='ENOSPC') throw error;
        }
      }
    };
    const results = await Promise.allSettled(Array.from({length:Math.min(this.config.downloadConcurrency,ids.length)},worker));
    const rejected = results.find((result) => result.status==='rejected'); if(rejected) throw rejected.reason;
    context.onProgress({failedAssets:failures}); if(failed) throw new HttpError(502,`${failed} download(s) failed; completed sources are preserved. Retry this job to resume.`);
    let processing;
    if(payload.processAfterDownload) processing = await this.processor.process({...payload,...payload.processing,assetIds:ids},context);
    return {completed,total:ids.length,bytes:completedBytes,existingBytes,planId:plan?.id,processing,reused,resumed,
      ...(payload.prepareForScorecarder ? { scorecarder: { readyAssets, query:'/api/scorecarder/query', stac:'/api/scorecarder/stac' } } : {})};
  }

  async checkUpdates(payload,context) {
    const sources = payload.sourceIds?.length ? payload.sourceIds : this.registry.list().map((source) => source.id);
    const warnings = []; const changed = []; let checked = 0;
    for(const id of sources) { try { await this.registry.refresh(id,context); } catch(error) { warnings.push({sourceId:id,message:error.message}); } }
    const assets = this.catalog.queryAssets({sourceIds:sources,localOnly:true,resolution:'all'}).filter((asset) => asset.remoteUrl);
    for(const asset of assets) {
      context.signal.throwIfAborted();
      try {
        const response = await this.network.response(asset.remoteUrl,{method:'HEAD',signal:context.signal});
        const etag=response.headers.get('etag'); const modified=response.headers.get('last-modified'); await response.body?.cancel();
        if(!response.ok) throw new Error(`HTTP ${response.status}`);
        const different = asset.etag && etag ? asset.etag!==etag : asset.lastModified && modified ? asset.lastModified!==modified : false;
        if(different) { const revision=etag||modified; const next=this.catalog.saveAsset({...asset,id:undefined,path:null,bytes:0,sha256:null,revision,expectedBytes:Number(response.headers.get('content-length'))||null}); changed.push(next.id); }
        else if(!asset.etag && !asset.lastModified) warnings.push({assetId:asset.id,message:'No prior ETag/Last-Modified; freshness is unknown, not assumed unchanged.'});
      } catch(error) { if(context.signal.aborted) throw error; warnings.push({assetId:asset.id,message:error.message}); }
      checked++; context.onProgress({stage:'update check',completed:checked,total:assets.length,changed:changed.length});
    }
    this.catalog.setSetting('lastUpdateCheck',new Date().toISOString());
    if(payload.downloadChanged && changed.length) this.enqueue('download',{assetIds:changed,storageRoot:payload.storageRoot});
    return {checked,changedAssetIds:changed,warnings};
  }
}