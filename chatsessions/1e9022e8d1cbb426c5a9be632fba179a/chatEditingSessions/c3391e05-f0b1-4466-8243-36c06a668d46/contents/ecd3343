#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
BUILD_DIR=${TERRAIN_BUILD_DIR:-"${HOME}/.cache/terrainserver-builder"}
mkdir -p "$BUILD_DIR/bootstrap"
if [[ $(uname -m) != x86_64 ]]; then printf '%s\n' 'Linux build requires x86_64.' >&2; exit 1; fi
VERSION=${NODE_VERSION:-v24.22.2}
NODE_ARCHIVE="node-${VERSION}-linux-x64.tar.xz"
curl --fail --location --retry 3 "https://nodejs.org/dist/${VERSION}/SHASUMS256.txt" --output "$BUILD_DIR/bootstrap/SHASUMS256.txt"
if [[ ! -f "$BUILD_DIR/bootstrap/$NODE_ARCHIVE" ]]; then curl --fail --location --retry 3 "https://nodejs.org/dist/${VERSION}/${NODE_ARCHIVE}" --output "$BUILD_DIR/bootstrap/$NODE_ARCHIVE"; fi
(cd "$BUILD_DIR/bootstrap" && grep " ${NODE_ARCHIVE}$" SHASUMS256.txt | sha256sum --check --status)
tar -xf "$BUILD_DIR/bootstrap/$NODE_ARCHIVE" -C "$BUILD_DIR/bootstrap"
export PATH="$BUILD_DIR/bootstrap/node-${VERSION}-linux-x64/bin:/usr/bin:/bin"
if [[ ! -x "$BUILD_DIR/bootstrap/bin/micromamba" ]]; then
  curl --fail --location --retry 3 https://micro.mamba.pm/api/micromamba/linux-64/latest --output "$BUILD_DIR/bootstrap/micromamba.tar.bz2"
  tar -xjf "$BUILD_DIR/bootstrap/micromamba.tar.bz2" -C "$BUILD_DIR/bootstrap" bin/micromamba
fi
export MAMBA_ROOT_PREFIX="$BUILD_DIR/mamba"
GIS_ENV=${GIS_ENV_ROOT:-"$BUILD_DIR/gis-env"}
if [[ -z ${GIS_ENV_ROOT:-} ]]; then
  if [[ -e "$GIS_ENV" ]]; then rm -rf -- "$GIS_ENV"; fi
  "$BUILD_DIR/bootstrap/bin/micromamba" create --yes --no-rc --override-channels --channel conda-forge --strict-channel-priority --prefix "$GIS_ENV" 'libgdal-core=3.13.2' 'libpdal-core=2.10.2'
fi
node "$ROOT/scripts/build-installer.js" --platform linux --gis-env "$GIS_ENV" --build-dir "$BUILD_DIR" --node-version "$VERSION"