import test from 'node:test';
import assert from 'node:assert/strict';
import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import { chromium } from 'playwright';
import { writeArrayBuffer } from 'geotiff';
import { createService } from '../src/app.js';

async function browserFixture(apiKey,action) {
  const root=await mkdtemp(path.join(os.tmpdir(),'terrain-browser-'));const originalRoot=process.env.STORAGE_ROOT;
  const service=await createService({storageRoot:root,catalogPath:':memory:',envPath:path.join(root,'.env'),port:0,apiKey,updateCheckDays:0});let server;let browser;
  try {
    server=service.app.listen(0,'127.0.0.1');await new Promise(resolve=>server.once('listening',resolve));
    const url=`http://127.0.0.1:${server.address().port}`;service.config.corsOrigins.push(url);
    browser=await chromium.launch({headless:true,...(process.platform==='win32'?{channel:process.env.PLAYWRIGHT_CHANNEL||'msedge'}:{})});
    const page=await browser.newPage({viewport:{width:1280,height:900}});const errors=[];page.on('pageerror',error=>errors.push(error.message));
    await action({service,page,url,root,errors});assert.deepEqual(errors,[]);
  }finally {
    await browser?.close();if(server)await new Promise(resolve=>server.close(resolve));await service.close();await rm(root,{recursive:true,force:true});
    if(originalRoot===undefined)delete process.env.STORAGE_ROOT;else process.env.STORAGE_ROOT=originalRoot;
  }
}

test('browser supports native forms, source options, destination changes, terrain previews, and mobile layouts',async()=>{
  await browserFixture('',async({service,page,url,root})=>{
    const extent=[-79.52,43.64,-79.519,43.641];const filename=path.join(root,'fixture.tif');
    await writeFile(filename,Buffer.from(writeArrayBuffer(Array.from({length:100},(value,index)=>100+index),{width:10,height:10,BitsPerSample:[8],SampleFormat:[1],ModelPixelScale:[0.0001,0.0001,0],ModelTiepoint:[0,0,0,-79.52,43.641,0],GeographicTypeGeoKey:4326,GTModelTypeGeoKey:2,GTRasterTypeGeoKey:1})));
    const asset=service.catalog.saveAsset({sourceId:'ontario',title:'Browser Raster',product:'dtm',extension:'tif',path:filename,bbox:extent,resolutionMeters:0.5,bytes:1100});let discovered;
    service.registry.discover=async input=>{discovered=input;return service.catalog.savePlan({request:input,sourceIds:input.sourceIds,assetIds:[asset.id],assetCount:1,complete:true,warnings:[],errors:[]});};
    await page.goto(url);await page.waitForFunction(()=>document.querySelector('#connection-label').textContent==='Online');assert.equal(await page.locator('[data-source]').count(),9);
    assert.equal(await page.locator('#connection-port').textContent(),`:${new URL(url).port}`);
    await page.locator('[data-source="pei"]').check();await page.locator('#resolution').selectOption('all');await page.locator('#area-course').selectOption('__sample');
    await page.locator('#save-course-button').click();await page.locator('#course-name').fill('Browser Area');await page.locator('#course-buffer').fill('0');await page.locator('#course-form button[type="submit"]').click();
    await page.waitForFunction(()=>!document.querySelector('#course-dialog').open);assert.ok(service.catalog.course('browser-area'));assert.equal(await page.locator('#area-course').inputValue(),'browser-area');
    await page.locator('#discover-button').click();await page.waitForFunction(()=>document.querySelector('#job-title').textContent.startsWith('Discover')&&document.querySelector('#job-detail .badge')?.textContent.trim()==='completed');
    assert.deepEqual(discovered.sourceIds.sort(),['ontario','pei']);assert.equal(discovered.resolution,'all');assert.equal(discovered.courseId,'browser-area');
    await page.locator('#job-dialog [data-close]').click();assert.match(await page.locator('#plan-heading').textContent(),/1 discovered/);
    const destination=path.join(root,'second-volume');await mkdir(destination);await page.locator('#default-folder-button').click();await page.locator('#folder-path').fill(destination);await page.locator('#use-folder').click();
    await page.waitForFunction(()=>!document.querySelector('#folder-dialog').open);assert.equal(service.config.storageRoot,destination);assert.match(await readFile(path.join(root,'.env'),'utf8'),/STORAGE_ROOT=/);
    await page.locator('[data-view="repository"]').click();await page.locator('#local-rows [data-action="asset"]').first().click();await page.waitForFunction(()=>document.querySelector('#asset-preview img')?.naturalWidth>0);
    const pixels=await page.locator('#asset-preview img').evaluate(image=>{const canvas=document.createElement('canvas');canvas.width=image.naturalWidth;canvas.height=image.naturalHeight;canvas.getContext('2d').drawImage(image,0,0);const data=canvas.getContext('2d').getImageData(0,0,canvas.width,canvas.height).data;const colors=new Set();let opaque=0;for(let index=0;index<data.length;index+=4){if(data[index+3])opaque++;colors.add(`${data[index]},${data[index+1]},${data[index+2]}`);}return {opaque,colors:colors.size};});
    assert.ok(pixels.opaque>10000&&pixels.colors>20);await page.locator('#asset-map-button').click();await page.locator('#map').click();await page.locator('.leaflet-popup-content').waitFor();assert.match(await page.locator('.leaflet-popup-content').textContent(),/source units/);
    await page.locator('#settings-button').click();await page.waitForFunction(()=>document.querySelector('#tool-list').textContent.includes('gdalwarp'));assert.match(await page.locator('#tool-list').textContent(),/pdal/);await page.locator('#settings-dialog [data-close]').click();
    await page.setViewportSize({width:393,height:851});await page.evaluate(()=>scrollTo(0,0));
    assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);assert.ok((await page.locator('#map').boundingBox()).y<300);
    await page.setViewportSize({width:320,height:740});assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);
  });
});

test('authenticated browser connects without persisting its key and can load local API documentation',async()=>{
  await browserFixture('browser-test-key',async({page,url})=>{
    await page.goto(url);await page.locator('#auth-dialog').waitFor();await page.locator('#api-key').fill('browser-test-key');await page.locator('#auth-form button[type="submit"]').click();
    await page.waitForFunction(()=>!document.querySelector('#auth-dialog').open&&document.querySelector('#connection-label').textContent==='Online');
    assert.equal(await page.locator('#api-key').inputValue(),'');assert.equal(await page.evaluate(()=>JSON.stringify({...localStorage,...sessionStorage}).includes('browser-test-key')),false);
    await page.goto(`${url}/docs`);await page.locator('.swagger-ui .info .title').waitFor();assert.match(await page.locator('.swagger-ui .info .title').textContent(),/TerrainServer/);
  });
});