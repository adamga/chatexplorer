<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#206c5a">
  <title>TerrainServer | Local Terrain Repository</title>
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <link rel="stylesheet" href="/vendor/draw/leaflet.draw.css">
  <link rel="stylesheet" href="/styles.css">
  <script defer src="/vendor/leaflet/leaflet.js"></script>
  <script defer src="/vendor/draw/leaflet.draw.js"></script>
  <script defer src="/vendor/lucide/lucide.min.js"></script>
  <script defer src="/app.js"></script>
</head>
<body>
  <header class="header">
    <a class="brand" href="/" aria-label="TerrainServer home"><span class="brand-mark"><i data-lucide="layers-3"></i></span><span>TerrainServer<small>LOCAL TERRAIN REPOSITORY</small></span></a>
    <div class="connection"><span id="connection-dot" class="status-dot"></span><span id="connection-label">Connecting</span><span class="port">:3123</span></div>
    <div class="header-actions"><a class="icon-button" href="/docs" target="_blank" title="API documentation" aria-label="API documentation"><i data-lucide="book-open"></i></a><button class="icon-button" id="auth-button" title="API authentication" aria-label="API authentication"><i data-lucide="key-round"></i></button><button class="icon-button" id="settings-button" title="Repository settings" aria-label="Repository settings"><i data-lucide="settings-2"></i></button></div>
  </header>
  <div class="navigation-band">
    <nav class="tabs" aria-label="Workspace">
      <button class="tab active" data-view="acquire" aria-current="page"><i data-lucide="map"></i><span>Acquire</span></button>
      <button class="tab" data-view="repository"><i data-lucide="database"></i><span>Repository</span><span id="asset-count" class="count">0</span></button>
      <button class="tab" data-view="courses"><i data-lucide="flag"></i><span>Courses</span></button>
      <button class="tab" data-view="jobs"><i data-lucide="activity"></i><span>Jobs</span><span id="job-count" class="count">0</span></button>
    </nav>
    <button class="destination-shortcut" id="default-folder-button" title="Change default storage destination"><i data-lucide="folder-open"></i><span id="storage-short">Storage</span><i data-lucide="chevron-right"></i></button>
  </div>
  <main>
    <section id="view-acquire" class="view workspace">
      <aside class="acquisition-panel">
        <form id="acquisition-form">
          <div class="section-heading"><h2>Acquisition</h2><button type="button" id="refresh-sources" class="icon-button small" title="Refresh provider catalogs" aria-label="Refresh provider catalogs"><i data-lucide="refresh-cw"></i></button></div>
          <fieldset><legend>Sources <button type="button" id="register-source" class="icon-button tiny" title="Register a government source" aria-label="Register a government source"><i data-lucide="plus"></i></button></legend><div id="source-controls" class="source-controls"></div></fieldset>
          <fieldset><legend>Products</legend><div id="product-controls" class="choice-wrap"></div></fieldset>
          <div class="field"><label for="resolution">Resolution</label><select id="resolution"><option value="best">Best available, with gap fill</option><option value="all">All published resolutions</option><option value="native">All native grids / surveys</option><option value="custom">Specific grid / export cell</option></select></div>
          <div class="field" id="custom-resolution-field" hidden><label for="custom-resolution">Cell size (meters)</label><input id="custom-resolution" type="number" value="0.5" min="0.001" max="1000" step="any"><div id="native-precision" class="metadata-note"></div></div>
          <div class="field-row"><div class="field"><label for="delivery">Delivery</label><select id="delivery"><option value="">Automatic</option></select></div><div class="field"><label for="format">Format</label><select id="format"><option value="">All published</option></select></div></div>
          <div class="field-row" id="export-options"><div class="field"><label for="interpolation">Interpolation</label><select id="interpolation"><option value="bilinear">Bilinear</option><option value="nearest">Nearest</option><option value="cubic">Cubic</option></select></div><div class="field"><label for="raster-function">Raster function</label><select id="raster-function"><option value="">Default elevation</option></select></div></div>
          <details class="collections"><summary>Collection options <span id="collection-count"></span></summary><div id="collection-controls"></div><button type="button" id="reset-collections" class="text-button">Automatic selection</button></details>
          <div id="source-note" class="provider-note"></div>
          <fieldset class="area-section"><legend>Extent</legend><div class="segmented"><label><input type="radio" name="scope" value="area" checked><span>Boundary</span></label><label><input type="radio" name="scope" value="source"><span>Whole source</span></label></div></fieldset>
          <div id="boundary-controls">
            <div class="field"><label for="area-course">Course / area</label><select id="area-course"><option value="">Unassigned area</option><option value="__sample">Ontario sample area</option></select></div>
            <div class="extent-toolbar"><span id="boundary-label">No boundary</span><div><button type="button" id="import-boundary" class="icon-button small" title="Import GeoJSON boundary" aria-label="Import GeoJSON boundary"><i data-lucide="file-up"></i></button><button type="button" id="save-course-button" class="icon-button small" title="Save boundary as a course" aria-label="Save boundary as a course"><i data-lucide="bookmark-plus"></i></button><button type="button" id="clear-boundary" class="icon-button small" title="Clear boundary" aria-label="Clear boundary"><i data-lucide="x"></i></button></div></div>
            <input id="boundary-file" type="file" accept=".json,.geojson,application/geo+json,application/json" hidden>
            <div class="bbox-grid"><label>West<input id="bbox-west" type="number" min="-180" max="180" step="any" placeholder="Longitude"></label><label>South<input id="bbox-south" type="number" min="-90" max="90" step="any" placeholder="Latitude"></label><label>East<input id="bbox-east" type="number" min="-180" max="180" step="any" placeholder="Longitude"></label><label>North<input id="bbox-north" type="number" min="-90" max="90" step="any" placeholder="Latitude"></label></div>
            <div class="field"><label for="buffer">Buffer (meters)</label><input id="buffer" type="number" min="0" max="10000" step="any" value="500"></div>
          </div>
          <div id="whole-source-note" class="warning-note" hidden>Entire selected provider coverage. File sizes may be unknown until download.</div>
          <div class="field destination-field"><label for="job-destination">Job destination</label><div class="input-action"><input id="job-destination" required placeholder="Absolute storage path"><button type="button" id="job-folder-button" class="icon-button" title="Browse destination" aria-label="Browse destination"><i data-lucide="folder-open"></i></button></div><span id="free-space" class="metadata-note"></span></div>
          <button type="submit" class="button primary full" id="discover-button"><i data-lucide="scan-search"></i>Discover Files</button>
        </form>
      </aside>
      <div class="workbench">
        <div class="map-toolbar"><div><span class="eyebrow">EXTENT &amp; COVERAGE</span><span id="map-location">Canada &amp; United States</span></div><div class="map-tools"><select id="basemap" aria-label="Basemap"><option value="offline">Local map</option><option value="streets">OpenStreetMap</option></select><button class="icon-button" id="fit-map" title="Fit selected extent" aria-label="Fit selected extent"><i data-lucide="focus"></i></button></div></div>
        <div class="map-frame"><div id="map" aria-label="Terrain acquisition map"></div><div class="map-legend"><span><b class="legend-boundary"></b>Boundary</span><span><b class="legend-plan"></b>Discovered</span><span><b class="legend-local"></b>Local</span></div><div class="map-stamp">WGS84<span id="map-file-count">0 local files</span></div></div>
        <section class="plan-section" aria-labelledby="plan-heading">
          <div class="plan-header"><div><span class="eyebrow">ACQUISITION REVIEW</span><h2 id="plan-heading">No active plan</h2><span id="plan-summary" class="metadata-note"></span></div><div class="plan-actions"><label class="check compact"><input type="checkbox" id="process-after">Process after download</label><button id="download-plan" class="button primary" disabled><i data-lucide="download"></i><span>Download</span></button></div></div>
          <div id="plan-warnings" hidden></div>
          <div class="table-scroll"><table class="asset-table"><thead><tr><th class="select-cell"><input id="select-all-plan" type="checkbox" aria-label="Select all plan files"></th><th>File / Source</th><th>Product</th><th>Native Grid</th><th>Size</th><th class="action-cell"></th></tr></thead><tbody id="plan-rows"><tr><td colspan="6" class="empty-cell"><i data-lucide="scan-search"></i><span>No acquisition plan</span></td></tr></tbody></table></div>
          <div class="pagination"><span id="plan-page-label">0 files</span><div><button id="plan-previous" class="icon-button small" title="Previous page" aria-label="Previous plan page" disabled><i data-lucide="chevron-left"></i></button><button id="plan-next" class="icon-button small" title="Next page" aria-label="Next plan page" disabled><i data-lucide="chevron-right"></i></button></div></div>
        </section>
      </div>
    </section>
    <section id="view-repository" class="view page-view" hidden>
      <div class="page-heading"><div><span class="eyebrow">LOCAL INVENTORY</span><h2>Repository</h2></div><div class="heading-actions"><button id="check-updates" class="button secondary"><i data-lucide="refresh-cw"></i>Check Updates</button><button id="refresh-repository" class="icon-button" title="Refresh repository" aria-label="Refresh repository"><i data-lucide="rotate-cw"></i></button></div></div>
      <div class="repository-stats"><div><span>Stored Files</span><strong id="stat-files">0</strong></div><div><span>Raw &amp; Generated</span><strong id="stat-bytes">0 B</strong></div><div><span>Saved Courses</span><strong id="stat-courses">0</strong></div><div><span>Free Space</span><strong id="stat-free">--</strong></div></div>
      <form id="repository-filter" class="filter-bar"><div class="field"><label for="local-search">Search</label><input id="local-search" type="search" placeholder="File or title"></div><div class="field"><label for="local-source">Source</label><select id="local-source"><option value="">All sources</option></select></div><div class="field"><label for="local-product">Product</label><select id="local-product"><option value="">All products</option><option value="point-cloud">Point cloud</option><option value="dtm">DTM</option><option value="dem">DEM</option><option value="dsm">DSM</option><option value="contours">Contours</option><option value="hillshade">Hillshade</option><option value="slope">Slope</option></select></div><div class="field"><label for="local-resolution">Resolution</label><select id="local-resolution"><option value="all">All grids</option><option value="best">Best available</option></select></div><div class="field"><label for="local-course">Course</label><select id="local-course"><option value="">All courses</option></select></div><button class="button secondary" type="submit"><i data-lucide="search"></i>Search</button></form>
      <div class="table-scroll"><table class="asset-table"><thead><tr><th>File / Source</th><th>Product</th><th>Native Grid</th><th>Size</th><th>Stored</th><th class="action-cell"></th></tr></thead><tbody id="local-rows"></tbody></table></div><div class="pagination"><span id="local-page-label">0 files</span><div><button id="local-previous" class="icon-button small" title="Previous page" aria-label="Previous repository page" disabled><i data-lucide="chevron-left"></i></button><button id="local-next" class="icon-button small" title="Next page" aria-label="Next repository page" disabled><i data-lucide="chevron-right"></i></button></div></div>
    </section>
    <section id="view-courses" class="view page-view" hidden>
      <div class="page-heading"><div><span class="eyebrow">COURSE WORKSPACES</span><h2>Courses</h2></div><button id="new-course" class="button primary"><i data-lucide="plus"></i>New Course</button></div>
      <div class="table-scroll"><table><thead><tr><th>Course</th><th>Region</th><th>Boundary</th><th>Buffer</th><th class="action-cell"></th></tr></thead><tbody id="course-rows"></tbody></table></div>
    </section>
    <section id="view-jobs" class="view page-view" hidden>
      <div class="page-heading"><div><span class="eyebrow">DURABLE QUEUE</span><h2>Jobs</h2></div><button id="refresh-jobs" class="icon-button" title="Refresh jobs" aria-label="Refresh jobs"><i data-lucide="rotate-cw"></i></button></div>
      <div class="table-scroll"><table class="jobs-table"><thead><tr><th>Job</th><th>Status</th><th>Progress</th><th>Transfer</th><th>Updated</th><th class="action-cell"></th></tr></thead><tbody id="job-rows"></tbody></table></div>
    </section>
  </main>
  <footer class="footer"><span><span class="status-dot local-dot"></span>Local-only terrain serving</span><span id="footer-status">Catalog connecting</span><span>TerrainServer 1.0.0</span></footer>
  <div id="toast" class="toast" role="status" hidden></div>
  <dialog id="auth-dialog" class="compact-dialog"><form id="auth-form"><div class="dialog-heading"><h2>API Authentication</h2><button type="button" class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><div class="field"><label for="api-key">API key</label><input id="api-key" type="password" autocomplete="off" required></div><div class="dialog-actions"><button class="button primary" type="submit"><i data-lucide="unlock-keyhole"></i>Connect</button></div></form></dialog>
  <dialog id="folder-dialog"><div class="dialog-heading"><h2 id="folder-title">Storage Destination</h2><button class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><form id="folder-path-form" class="folder-path"><select id="folder-drive" aria-label="Drive"></select><input id="folder-path" aria-label="Absolute folder path" required><button class="icon-button" title="Open folder" aria-label="Open folder"><i data-lucide="arrow-right"></i></button></form><div class="folder-parent"><button id="folder-up" class="button secondary"><i data-lucide="corner-left-up"></i>Parent</button><span id="folder-error" class="error-text"></span></div><div id="folder-list" class="folder-list"></div><div class="dialog-actions"><button data-close class="button secondary">Cancel</button><button id="use-folder" class="button primary"><i data-lucide="folder-check"></i>Use Destination</button></div></dialog>
  <dialog id="settings-dialog"><div class="dialog-heading"><h2>Repository Settings</h2><button class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><dl id="settings-details" class="detail-list"></dl><div class="section-heading"><h3>GIS Toolchain</h3><button id="check-tools" class="icon-button small" title="Check GIS tools" aria-label="Check GIS tools"><i data-lucide="refresh-cw"></i></button></div><div id="tool-list" class="tool-list"></div><div class="dialog-actions"><button id="settings-folder" class="button secondary"><i data-lucide="folder-open"></i>Change Destination</button><a href="/docs" target="_blank" class="button primary"><i data-lucide="book-open"></i>API Reference</a></div></dialog>
  <dialog id="course-dialog"><form id="course-form"><div class="dialog-heading"><h2>Save Course</h2><button type="button" class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><div class="field"><label for="course-name">Course name</label><input id="course-name" required maxlength="200"></div><div class="field-row"><div class="field"><label for="course-country">Country</label><select id="course-country"><option value="CA">Canada</option><option value="US">United States</option></select></div><div class="field"><label for="course-region">Province / state</label><input id="course-region" value="ON" maxlength="60"></div></div><div class="field"><label for="course-buffer">Buffer (meters)</label><input id="course-buffer" type="number" value="500" min="0" max="10000" step="any"></div><span id="course-boundary-status" class="metadata-note"></span><div class="dialog-actions"><button type="button" id="course-import" class="button secondary"><i data-lucide="file-up"></i>Import Boundary</button><button type="submit" class="button primary"><i data-lucide="save"></i>Save Course</button></div></form></dialog>
  <dialog id="processing-dialog"><form id="processing-form"><div class="dialog-heading"><h2>Generate Terrain</h2><button type="button" class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><div class="field"><label for="processing-course">Course</label><select id="processing-course" required></select></div><fieldset><legend>Outputs</legend><div class="choice-wrap"><label class="check"><input type="checkbox" name="outputs" value="dtm" checked>DTM</label><label class="check"><input type="checkbox" name="outputs" value="dsm">DSM</label><label class="check"><input type="checkbox" name="outputs" value="contours" checked>Contours</label><label class="check"><input type="checkbox" name="outputs" value="hillshade" checked>Hillshade</label><label class="check"><input type="checkbox" name="outputs" value="slope" checked>Slope</label></div></fieldset><div class="field-row"><div class="field"><label for="processing-resolution">Output cell (meters)</label><input id="processing-resolution" type="number" min="0.001" step="any" placeholder="Finest native grid"></div><div class="field"><label for="processing-resampling">Raster resampling</label><select id="processing-resampling"><option value="bilinear">Bilinear</option><option value="near">Nearest</option><option value="cubic">Cubic</option><option value="cubicspline">Cubic spline</option><option value="lanczos">Lanczos</option><option value="average">Average</option><option value="mode">Mode</option></select></div></div><fieldset><legend>Contour intervals (meters)</legend><div class="choice-wrap"><label class="check"><input type="checkbox" name="intervals" value="0.5" checked>0.5</label><label class="check"><input type="checkbox" name="intervals" value="1" checked>1</label><label class="check"><input type="checkbox" name="intervals" value="2" checked>2</label><label class="check custom-interval"><input id="use-custom-interval" type="checkbox">Custom<input id="custom-interval" type="number" min="0.01" step="any" value="5" aria-label="Custom contour interval"></label></div></fieldset><div class="field-row"><div class="field"><label for="hillshade-style">Hillshade</label><select id="hillshade-style"><option value="multidirectional">Multidirectional</option><option value="classic">Classic</option></select></div><div class="field"><label for="slope-units">Slope</label><select id="slope-units"><option value="degrees">Degrees</option><option value="percent">Percent</option></select></div></div><div class="processing-checks"><label class="check"><input id="ground-only" type="checkbox" checked>Ground-classified DTM</label><label class="check"><input id="prefer-point-cloud" type="checkbox">Prefer point clouds</label></div><div class="field"><label for="z-scale">Point-cloud elevation scale</label><input id="z-scale" type="number" value="1" min="0.00001" step="any"></div><div class="dialog-actions"><button class="button primary" type="submit"><i data-lucide="mountain"></i>Generate Terrain</button></div></form></dialog>
  <dialog id="asset-dialog" class="asset-dialog"><div class="dialog-heading"><h2 id="asset-title">Terrain Asset</h2><button class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><div id="asset-preview" class="asset-preview" hidden></div><dl id="asset-details" class="detail-list"></dl><pre id="asset-json" class="json-output" hidden></pre><div class="dialog-actions"><button id="asset-json-button" class="button secondary"><i data-lucide="braces"></i>Metadata</button><button id="asset-map-button" class="button secondary"><i data-lucide="map"></i>View on Map</button><button id="asset-download-button" class="button primary"><i data-lucide="download"></i>Download</button></div></dialog>
  <dialog id="job-dialog" class="job-dialog"><div class="dialog-heading"><h2 id="job-title">Job</h2><button class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><div id="job-detail"></div><pre id="job-logs" class="job-logs"></pre><div id="job-dialog-actions" class="dialog-actions"></div></dialog>
  <dialog id="confirm-dialog" class="compact-dialog"><form id="confirm-form"><div class="dialog-heading"><h2 id="confirm-title">Confirm Download</h2><button type="button" class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><p id="confirm-message"></p><div class="dialog-actions"><button type="button" data-close class="button secondary">Cancel</button><button type="submit" class="button primary" id="confirm-submit"><i data-lucide="download"></i>Start Download</button></div></form></dialog>
  <dialog id="source-dialog"><form id="source-form"><div class="dialog-heading"><h2>Register Source</h2><button type="button" class="icon-button" data-close title="Close" aria-label="Close"><i data-lucide="x"></i></button></div><div class="field"><label for="source-json">Source configuration (JSON)</label><textarea id="source-json" rows="15" spellcheck="false" required></textarea></div><div class="dialog-actions"><button type="submit" class="button primary"><i data-lucide="plus"></i>Register Source</button></div></form></dialog>
</body>
</html>