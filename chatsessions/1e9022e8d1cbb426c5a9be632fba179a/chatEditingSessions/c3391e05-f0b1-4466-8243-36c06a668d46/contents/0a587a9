import { lookup } from 'node:dns';
import { createReadStream, createWriteStream, constants } from 'node:fs';
import { stat, mkdir, readFile, writeFile, unlink, link, copyFile, open, statfs } from 'node:fs/promises';
import path from 'node:path';
import { Readable, Transform } from 'node:stream';
import { pipeline } from 'node:stream/promises';
import { createHash } from 'node:crypto';
import { setTimeout as delay } from 'node:timers/promises';
import ipaddr from 'ipaddr.js';
import { Agent, fetch } from 'undici';
import { HttpError } from './spatial.js';

const governmentDomains = ['gov', 'gc.ca', 'canada.ca', 'geo.ca', 'ontario.ca', 'gov.on.ca', 'arcgis.com', 'amazonaws.com',
  'gov.bc.ca', 'gouv.qc.ca', 'donneesquebec.ca', 'novascotia.ca', 'alberta.ca', 'saskatchewan.ca', 'gov.sk.ca',
  'princeedwardisland.ca', 'gov.pe.ca', 'open.canada.ca', 'data.gov.bc.ca', 'snb.ca'];

export function publicAddress(address) {
  try {
    const parsed = ipaddr.process(address);
    return parsed.range() === 'unicast';
  } catch { return false; }
}

export async function fileHash(filename) {
  const hash = createHash('sha256');
  for await (const chunk of createReadStream(filename)) hash.update(chunk);
  return hash.digest('hex');
}

export async function publishFile(temporary, destination) {
  try { await link(temporary, destination); }
  catch (error) {
    if (error.code === 'EEXIST') throw new HttpError(409, 'Refusing to overwrite an existing raw source file.');
    if (!['EPERM', 'EOPNOTSUPP', 'ENOTSUP', 'EXDEV', 'ENOSYS'].includes(error.code)) throw error;
    await copyFile(temporary, destination, constants.COPYFILE_EXCL);
  }
  await unlink(temporary);
}

export class Network {
  constructor(config) {
    this.config = config;
    this.agent = new Agent({ connect: { lookup: (hostname, options, callback) => {
      lookup(hostname, { ...options, all: true }, (error, records) => {
        if (error) return callback(error);
        const allowed = records.filter((record) => config.allowPrivateDownloadHosts || publicAddress(record.address));
        if (!allowed.length) return callback(new Error('Download hostname resolves to a private or reserved address.'));
        if (options.all) callback(null, allowed);
        else callback(null, allowed[0].address, allowed[0].family);
      });
    } } });
  }

  validateUrl(input) {
    let url;
    try { url = new URL(input); } catch { throw new HttpError(400, 'Invalid download URL.'); }
    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
      throw new HttpError(400, 'Only HTTP(S) URLs without embedded credentials are supported.');
    }
    const host = url.hostname.replace(/^\[|\]$/g, '').toLowerCase();
    if (!this.config.allowPrivateDownloadHosts) {
      if (ipaddr.isValid(host) && !publicAddress(host)) throw new HttpError(400, 'Private and reserved download addresses are blocked.');
      const domains = [...governmentDomains, ...(this.config.extraDownloadHosts || [])];
      if (!domains.some((domain) => host === domain || host.endsWith(`.${domain}`))) {
        throw new HttpError(400, `Download host ${host} is not allowed. Configure DOWNLOAD_ALLOWED_HOSTS in .env for a trusted public provider.`);
      }
      if (url.port && !['80', '443'].includes(url.port)) throw new HttpError(400, 'Nonstandard provider ports are blocked.');
    }
    return url;
  }

  async response(input, options = {}) {
    let url = this.validateUrl(input);
    const signals = [options.signal].filter(Boolean);
    const timeoutMs = options.timeoutMs ?? this.config.requestTimeoutMs;
    if (timeoutMs) signals.push(AbortSignal.timeout(timeoutMs));
    const signal = signals.length ? AbortSignal.any(signals) : undefined;
    for (let redirects = 0; redirects <= 5; redirects++) {
      const response = await fetch(url, { ...options, signal, dispatcher: this.agent, redirect: 'manual',
        headers: { 'User-Agent': 'TerrainServer/1.0 government-terrain-offline-cache', ...options.headers } });
      if ([301, 302, 303, 307, 308].includes(response.status)) {
        const location = response.headers.get('location');
        await response.body?.cancel();
        if (!location) throw new HttpError(502, 'Provider returned a redirect without a location.');
        url = this.validateUrl(new URL(location, url).href);
        if (response.status === 303) options = { ...options, method: 'GET', body: undefined };
        continue;
      }
      return response;
    }
    throw new HttpError(502, 'Provider exceeded five redirects.');
  }

  async json(url, options = {}) {
    const response = await this.response(url, options);
    if (!response.ok) { await response.body?.cancel(); throw new HttpError(502, `Provider returned HTTP ${response.status}.`, { url: String(url) }); }
    const body = await response.json();
    if (body.error) throw new HttpError(502, body.error.message || body.error.description || 'Provider returned an error.', body.error);
    return body;
  }

  async text(url, options = {}) {
    const response = await this.response(url, options);
    if (!response.ok) { await response.body?.cancel(); throw new HttpError(502, `Provider returned HTTP ${response.status}.`); }
    return response.text();
  }

  async download(url, destination, options = {}) {
    this.validateUrl(url);
    await mkdir(path.dirname(destination), { recursive: true });
    const existing = await stat(destination).catch((error) => { if (error.code === 'ENOENT') return null; throw error; });
    if (existing) return { path: destination, bytes: existing.size, sha256: await fileHash(destination), reused: true };
    for (let attempt = 0; attempt <= this.config.downloadRetries; attempt++) {
      options.signal?.throwIfAborted();
      try { return await this.downloadAttempt(url, destination, options); }
      catch (error) {
        if (options.signal?.aborted || attempt >= this.config.downloadRetries || error.status === 400 || error.status === 409) throw error;
        options.onRetry?.(attempt + 1, error);
        await delay(Math.min(1000 * 2 ** attempt, 8000), undefined, { signal: options.signal });
      }
    }
  }

  async downloadAttempt(url, destination, options) {
    const partial = `${destination}.part`;
    const metadataFile = `${partial}.json`;
    const previous = await readFile(metadataFile, 'utf8').then(JSON.parse).catch((error) => { if (error.code === 'ENOENT' || error instanceof SyntaxError) return null; throw error; });
    let offset = previous?.url === String(url) && (previous.etag || previous.lastModified)
      ? await stat(partial).then((info) => info.size).catch((error) => { if (error.code === 'ENOENT') return 0; throw error; }) : 0;
    const controller = new AbortController();
    const signal = options.signal ? AbortSignal.any([options.signal, controller.signal]) : controller.signal;
    let timer;
    const touch = () => { clearTimeout(timer); timer = setTimeout(() => controller.abort(new Error('Download stalled: idle timeout.')), this.config.downloadIdleTimeoutMs); timer.unref?.(); };
    touch();
    try {
      const headers = offset ? { Range: `bytes=${offset}-`, 'If-Range': previous.etag || previous.lastModified } : {};
      let response = await this.response(url, { signal, timeoutMs: 0, headers });
      if (response.status === 416) {
        await response.body?.cancel();
        offset = 0;
        response = await this.response(url, { signal, timeoutMs: 0 });
      }
      if (!response.ok) { await response.body?.cancel(); throw new HttpError(502, `Download returned HTTP ${response.status}.`); }
      const contentType = response.headers.get('content-type') || '';
      if (/text\/html|application\/(?:problem\+)?json/i.test(contentType) && options.extension !== 'geojson') {
        await response.body?.cancel();
        throw new HttpError(502, 'Provider returned HTML/JSON instead of a terrain file. There may be no coverage for this area.');
      }
      if (response.status === 206) {
        const range = /^bytes (\d+)-(\d+)\/(\d+)$/.exec(response.headers.get('content-range') || '');
        if (!range || Number(range[1]) !== offset) { await response.body?.cancel(); throw new HttpError(502, 'Provider returned an invalid Content-Range.'); }
      } else { offset = 0; }
      const length = Number(response.headers.get('content-length')) || 0;
      const total = length ? length + offset : options.expectedBytes || null;
      const hash = createHash('sha256');
      if (offset) for await (const chunk of createReadStream(partial)) { signal.throwIfAborted(); hash.update(chunk); touch(); }
      await writeFile(metadataFile, JSON.stringify({ url: String(url), etag: response.headers.get('etag'), lastModified: response.headers.get('last-modified'), total }));
      let bytes = offset;
      let lastDiskCheck = 0;
      const measure = new Transform({ transform: (chunk, encoding, callback) => {
        bytes += chunk.length;
        hash.update(chunk);
        touch();
        options.onProgress?.({ bytes, total, resumedBytes: offset });
        if (options.diskRoot && bytes - lastDiskCheck > 64 * 1024 * 1024) {
          lastDiskCheck = bytes;
          statfs(options.diskRoot).then((info) => {
            if (Number(info.bavail) * Number(info.bsize) < this.config.minFreeDiskGb * 1024 ** 3) {
              callback(new HttpError(507, 'Storage reserve reached; partial download is retained for resume.'));
            } else callback(null, chunk);
          }, callback);
        } else callback(null, chunk);
      } });
      await pipeline(Readable.fromWeb(response.body), measure, createWriteStream(partial, { flags: offset ? 'a' : 'w' }), { signal });
      if (total && bytes !== total) throw new HttpError(502, `Incomplete download: expected ${total} bytes, received ${bytes}.`);
      if (options.expectedBytes && bytes !== options.expectedBytes) throw new HttpError(502, 'Downloaded size differs from provider metadata.');
      const sha256 = hash.digest('hex');
      if (options.sha256 && sha256 !== options.sha256) throw new HttpError(502, 'Provider checksum verification failed.');
      await verifySignature(partial, options.extension);
      await publishFile(partial, destination);
      await unlink(metadataFile).catch((error) => { if (error.code !== 'ENOENT') throw error; });
      return { path: destination, bytes, sha256, resumedBytes: offset, etag: response.headers.get('etag'), lastModified: response.headers.get('last-modified') };
    } finally { clearTimeout(timer); controller.abort(); }
  }

  async close() { await this.agent.close(); }
}

async function verifySignature(filename, extension) {
  if (!extension) return;
  const handle = await open(filename, 'r');
  try {
    const bytes = Buffer.alloc(8);
    await handle.read(bytes, 0, 8, 0);
    const tiff = (bytes[0] === 73 && bytes[1] === 73 && [42, 43].includes(bytes[2])) || (bytes[0] === 77 && bytes[1] === 77 && [42, 43].includes(bytes[3]));
    if (['tif', 'tiff'].includes(extension) && !tiff) throw new HttpError(502, 'Download does not have a valid TIFF/BigTIFF signature.');
    if (['las', 'laz', 'copc.laz'].includes(extension) && bytes.subarray(0, 4).toString() !== 'LASF') throw new HttpError(502, 'Download does not have a LAS/LAZ signature.');
    if (extension === 'zip' && bytes.subarray(0, 2).toString() !== 'PK') throw new HttpError(502, 'Download does not have a ZIP signature.');
  } finally { await handle.close(); }
}