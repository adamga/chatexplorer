#!/usr/bin/env bash
set -euo pipefail
umask 077
PACKAGE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
APP_DIR=/opt/terrainserver
STATE_DIR=/var/lib/terrainserver
STORAGE_ROOT=
PORT=3123
BIND=127.0.0.1
NO_SERVICE=0
REQUIRE_KEY=0
while (($#)); do
  case "$1" in
    --package-root) PACKAGE_ROOT=$2; shift 2;;
    --app-dir) APP_DIR=$2; shift 2;;
    --state-dir) STATE_DIR=$2; shift 2;;
    --storage-root) STORAGE_ROOT=$2; shift 2;;
    --port) PORT=$2; shift 2;;
    --bind) BIND=$2; shift 2;;
    --no-service) NO_SERVICE=1; shift;;
    --require-key) REQUIRE_KEY=1; shift;;
    --help) printf '%s\n' 'TerrainServer setup: --app-dir PATH --state-dir PATH --storage-root PATH --port 3123 --bind 127.0.0.1 --require-key --no-service'; exit 0;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 1;;
  esac
done
if [[ $(uname -m) != x86_64 ]]; then printf '%s\n' 'Installer requires Linux x86_64 with glibc.' >&2; exit 1; fi
if ((NO_SERVICE == 0 && EUID != 0)); then printf '%s\n' 'System service installation requires root. Run the installer as administrator, or use --no-service with user-owned paths.' >&2; exit 1; fi
for DIRECTORY in "$APP_DIR" "$STATE_DIR"; do
  if [[ "$DIRECTORY" != /* || "$DIRECTORY" == / || "$DIRECTORY" == "$HOME" || "$DIRECTORY" =~ ^/(opt|usr|usr/local|var|var/lib|etc|home|srv|mnt|tmp)$ || "$DIRECTORY" == *$'\n'* || -L "$DIRECTORY" ]]; then printf '%s\n' 'Choose dedicated absolute program and state directories, not system roots or symlinks.' >&2; exit 1; fi
done
APP_DIR=$(realpath -m -- "$APP_DIR")
STATE_DIR=$(realpath -m -- "$STATE_DIR")
if [[ "$STATE_DIR" == "$APP_DIR" || "$STATE_DIR" == "$APP_DIR/"* ]]; then printf '%s\n' 'Persistent state must be outside the program directory.' >&2; exit 1; fi
if [[ -d "$APP_DIR" && -n $(find "$APP_DIR" -mindepth 1 -maxdepth 1 -print -quit) && ! -f "$APP_DIR/installation.json" ]]; then printf '%s\n' 'The program directory is not empty and is not an existing TerrainServer installation.' >&2; exit 1; fi
if ((NO_SERVICE == 0)); then
  if [[ -f /etc/systemd/system/terrainserver.service ]]; then
    if ! grep -Fq "$APP_DIR/runtime/node/bin/node" /etc/systemd/system/terrainserver.service; then printf '%s\n' 'An existing TerrainServer service belongs to another installation.' >&2; exit 1; fi
    systemctl stop terrainserver.service
  fi
fi
mkdir -p "$APP_DIR" "$STATE_DIR"
for DIRECTORY in src public node_modules runtime scripts installer third-party; do rm -rf -- "$APP_DIR/$DIRECTORY"; done
cp -a "$PACKAGE_ROOT/." "$APP_DIR/"
ARGUMENTS=("$APP_DIR/scripts/configure-service.js" --app-dir "$APP_DIR" --state-dir "$STATE_DIR" --platform linux --port "$PORT" --host "$BIND")
if [[ -n "$STORAGE_ROOT" ]]; then ARGUMENTS+=(--storage-root "$STORAGE_ROOT"); fi
if ((REQUIRE_KEY)); then ARGUMENTS+=(--require-key); fi
"$APP_DIR/runtime/node/bin/node" "${ARGUMENTS[@]}"
chmod 700 "$STATE_DIR"
chmod 600 "$STATE_DIR/.env"
if ((NO_SERVICE == 0)); then
  if ! getent group terrainserver >/dev/null; then groupadd --system terrainserver; fi
  if ! id terrainserver >/dev/null 2>&1; then useradd --system --gid terrainserver --home-dir "$STATE_DIR" --no-create-home --shell /usr/sbin/nologin terrainserver; fi
  chown terrainserver:terrainserver "$STATE_DIR" "$STATE_DIR/.env"
  while IFS= read -r DIRECTORY; do
    mkdir -p "$DIRECTORY"
    chown terrainserver:terrainserver "$DIRECTORY"
  done < <("$APP_DIR/runtime/node/bin/node" --input-type=module -e 'import fs from "node:fs";import path from "node:path";const config=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));for(const directory of [config.storageRoot,path.dirname(config.catalogPath),path.join(config.stateDir,"logs"),path.join(config.stateDir,"tmp")])console.log(directory);' "$APP_DIR/installation.json")
  find "$APP_DIR" -type d -exec chmod 755 {} +
  find "$APP_DIR" -type f -exec chmod go+r {} +
  install -m 644 "$APP_DIR/terrainserver.service" /etc/systemd/system/terrainserver.service
  systemctl daemon-reload
  systemctl enable --now terrainserver.service
  systemctl is-active --quiet terrainserver.service
  printf '%s\n' 'TerrainServer systemd service installed and running.'
else
  printf 'Foreground launch: TERRAIN_CONFIG_PATH=%q %q %q\n' "$STATE_DIR/.env" "$APP_DIR/runtime/node/bin/node" "$APP_DIR/src/server.js"
fi
printf '%s\n' 'Upgrades and uninstall preserve configuration, catalog, logs, and terrain data. Remote access requires a key and a TLS reverse proxy.'