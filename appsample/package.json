{
  "name": "chat-explorer",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A local, read-only observatory for persisted VS Code chat sessions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --max-old-space-size=8192 src/server.js",
    "dev": "node --max-old-space-size=8192 --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/diff.js && node --check src/parser.js && node --check src/summarizer.js && node --check src/server.js && node --check src/library.js && node --check src/indexer.js && node --check public/icons.js && node --check public/markdown.js && node --check public/app.js && node --check public/log.js && node --check build/render-icon.cjs && node --check electron/main.mjs && node --check electron/preload.cjs && node --check electron/backend.mjs",
    "desktop": "electron .",
    "icon": "node build/render-icon.cjs",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "Chronicle",
  "author": "Chronicle",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.chronicle.chatexplorer",
    "productName": "Chronicle",
    "copyright": "Local, read-only VS Code chat history explorer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "agentconfig/**/*",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Chronicle-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chronicle",
      "uninstallDisplayName": "Chronicle - Chat Explorer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
